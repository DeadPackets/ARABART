      </g>
      <text x="24" y="292" data-s="7">4Ch name = "NONAME.TXT"</text>
      <g data-s="3+">
        <text x="6" y="338" class="t-cy">His table 00ADh</text>
        {['02D1:03B9 draw', '02D1:0C3E', '02D1:040D key', '02D1:1A02 same', '02D1:1A12 same'].map((t, i) => <><rect class:list={[i < 3 ? 'box-hi' : 'box']} x="6" y={348 + i * 24} width="348" height="24" /><text class:list={[{ 't-bk': i < 3 }]} x="16" y={365 + i * 24}>{i}  {t}</text></>)}
      </g>
      <g data-s="5+">
        <text x="6" y="500" class="t-cy">Line table, 2,000 bytes</text>
        {[0, 1, 2, 3].map(i => <rect class="box" x="6" y={510 + i * 24} width="348" height="24" />)}
      </g>
      <text x="90" y="527" data-s="6">0000:0000</text>
      <rect class="box-hi" x="6" y="510" width="348" height="24" data-s="7" />
      <g data-s="5+">{['[0]', '[1]', '…', '[499]'].map((t, i) => <text class:list={{ 'eg-r0': !i }} x="16" y={527 + i * 24}>{t}</text>)}</g>
      <g data-s="6+">{[1, 3].map(i => <text x="90" y={527 + i * 24}>0000:0000</text>)}</g>
      <g data-s="7">
        <text class="t-bk" x="210" y="527">line 0 ↓</text>
        <text x="6" y="652" class="t-cy">Line 0, 255 bytes</text>
        <rect class="box-ink" x="6" y="662" width="348" height="30" /><text class="t-bk" x="16" y="682">00 00 00 … 00</text>
      </g>
