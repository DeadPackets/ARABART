---
// HandySwitcher, DinarSoft's task manager for Windows Mobile (2003 to 2008), reverse engineered from the archived
// installers: 2.7 (2006-07-15), 3.1 first build (2008-04-15) and 3.1 Build 78 (2008-07-20).
// Facts: research/dinarsoft/re/handyswitcher/ (HOW.md, PROOF.md), research/career.md, research/dinarsoft/site/handyswitcher/.
import LiveSwitcher from '../components/toys/ds-handyswitcher/LiveSwitcher.astro';
import Parts from '../components/toys/ds-handyswitcher/Parts.astro';
import TopBar from '../components/toys/ds-handyswitcher/TopBar.astro';
import Closer from '../components/toys/ds-handyswitcher/Closer.astro';
import Settings from '../components/toys/ds-handyswitcher/Settings.astro';
import KeyEngine from '../components/toys/ds-handyswitcher/KeyEngine.astro';
import TrialClock from '../components/toys/ds-handyswitcher/TrialClock.astro';
import ThenNow from '../components/explain/ThenNow.astro';
import Deep from '../components/explain/Deep.astro';
import Listing from '../components/explain/Listing.astro';
