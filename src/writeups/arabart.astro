---
// ARABART, the flagship page. Facts: research/arabart.md, research/artifacts/arabart/port/HOW.md, research/programs.md,
// src/data/programs.ts and his binaries. Every Arabic letter drawn on this page comes from his own engine (src/lib/arabart).
import Typewriter from '../components/toys/Typewriter.astro';
import DragWord from '../components/toys/arabart/DragWord.astro';
import LetterByte from '../components/toys/arabart/LetterByte.astro';
import ShapeLoop from '../components/toys/arabart/ShapeLoop.astro';
import SizeBars from '../components/toys/arabart/SizeBars.astro';
import GlyphRuns from '../components/toys/arabart/GlyphRuns.astro';
import StyleLab from '../components/toys/arabart/StyleLab.astro';
import ItalicJoin from '../components/toys/arabart/ItalicJoin.astro';
import Programs from '../components/toys/arabart/Programs.astro';
import Pix from '../components/toys/arabart/Pix.astro';
import Window from '../components/shell/Window.astro';
import Steps from '../components/explain/Steps.astro';
import ThenNow from '../components/explain/ThenNow.astro';
import Listing from '../components/explain/Listing.astro';
import Deep from '../components/explain/Deep.astro';
import Term from '../components/explain/Term.astro';
import { render, draw, svgRuns, translate, FORMS } from '../components/toys/arabart/core.ts';
import { ssrBin } from '../components/toys/arabart/ssr.ts';

const bin = ssrBin();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = render(bin, '~gtk ~guvfd', { font: 4, mode: '3d', color: 14, shadow: 4 });
// Small pictures for the diagrams, drawn by his engine
const art = (keys: string, font: number, color = 14, mode: 'plain' | '3d' = 'plain') => {
  const img = render(bin, keys, { font, color, mode, shadow: 4 });
  return { w: img.width, h: img.height, paths: svgRuns(img) };
};
const screenArt = art('~gtk ~guvfd', 3, 14, '3d');
const pesmArt = art('fsl hggi hgvplk hgvpdl', 1, 14);
const ain = translate(bin, 'u')[0] & 0x3f;
const forms = [0, 1, 2, 3].map(f => ({ form: FORMS[f], img: draw(bin, [ain | (f << 6)], { font: 3, color: 14 }) }));

const CALL = [
  { a: ['mov  ax,3603h', '; pick font 3'], p: 1 }, { a: ['mov  cx,3', ''], p: 1 }, { a: ['int  10h', ''], p: 1 },
  { a: ['mov  ax,3601h', '; colors: red text, white shadow'], p: 2 }, { a: ['mov  cx,0F04h', ''], p: 2 }, { a: ['int  10h', ''], p: 2 },
  { a: ['mov  ax,3608h', '; draw 3-D text'], p: 3 }, { a: ['mov  cx,639', '; right edge'], p: 3 }, { a: ['mov  bx,100', '; line bottom'], p: 3 },
  { a: ['mov  dx,offset msg', "; msg db '~gtk ~guvfd',0"], p: 3 }, { a: ['int  10h', ''], p: 3 },
];
const WEB = [
  { l: "const arabart = 'http://localhost/arabart';", p: 0 },
  { l: "await post(`${arabart}/font`, { font: 3 });", p: 1 },
  { l: "await post(`${arabart}/colors`, { text: 4, shadow: 15 });", p: 2 },
  { l: "await post(`${arabart}/draw3d`, {", p: 3 },
  { l: "  right: 639, bottom: 100, text: '~gtk ~guvfd' });", p: 3 },
];
const API = [
  ['00', 'Are you there?', 'AX = 5944h, and BX = 040Fh: version 4.15'],
  ['01', 'Set the colors', 'CL = text color, CH = shadow color'],
  ['02', 'Get the colors', 'CL, CH'],
  ['03', 'Pick a font', 'CX = 1 to 5'],
  ['04', 'Which font?', 'CX = the current font, DX = its line height'],
  ['05', 'Measure text', 'DS:DX = the text; CX comes back with its width in pixels'],
  ['06', 'Measure 3-D text', 'DS:DX = the text'],
  ['07', 'Draw text', 'DS:DX = the text, CX = right edge, BX = line bottom'],
  ['08', 'Draw 3-D text', 'as 07, with the shadow drawn first'],
  ['09', 'Move the pen', 'CX = x, BX = y'],
  ['0A', 'Where is the pen?', 'CX = x, BX = y'],
];
const PROGRAMS = [
  {
    file: 'DEMO.EXE', size: '18,129', date: '1991', title: 'The ARABART demo', img: 'arabart-demo.png', href: '/program/arabart-demo/',
    alt: 'His demo: الفن العربي ٤,١٥ in fonts 1 to 3 and twelve colors, on a black VGA screen.',
    body: 'His showcase for the library: one line in fonts 1 to 4 and in 12 colors, with stretched letters, then all of it again in italic. It is written in Borland C++, and every call to ARABART is <b>a few lines of C: fill in four numbers, then make one call</b>.',
  },
  {
    file: 'EDITOR.EXE', size: '17,492', date: '1991', title: 'The ARABART editor', img: 'arabart-editor.png', href: '/program/arabart-editor/',
    alt: 'His editor: one line of Arabic, الفن العربي ٤,١٥, in yellow with a red 3-D shadow.',
    body: 'A one-line Arabic typewriter. After every key it clears the screen and asks ARABART to draw the whole line again. <b>Shift+Q, W, E and R</b> pick fonts 1 to 4, <b>Shift+C</b> the text color, <b>Shift+V</b> the shadow color, and <b>Shift+\\</b> turns 3-D on and off. The typewriter at the top of this page is the same idea, on the same code.',
  },
  {
    file: 'SUN.EXE', size: '47,709', date: '9-1993', title: 'The Brave Sun', img: 'brave-sun.png', href: '/program/brave-sun/',
    alt: 'The Brave Sun title card: الشمس الجريئة, a line that calls it an educational program for young Arabic speakers, and his name.',
    body: 'His entry to the PC Middle East competition for Arabic educational software, which won 3rd place. Every word of Arabic in it comes from ARABART. It picks a font 59 times, uses <b>font 5</b>, made just for it, and builds two effects of its own on top of ARABART: a shadow and an outline.',
  },
];
---

<article class="ab">
  <section class="ab-hero" id="type" aria-labelledby="ab-h1">
    <header class="ab-hero-head">
      <h1 id="ab-h1">ARABART</h1>
      <Pix img={title} scale={4} class="ab-hero-ar" label="الفن العربي, Arabic art, drawn by his engine" />
      <p class="ab-hero-lead">The Arabic library Yasser Awad wrote in Port Said, Egypt, from 1991 to 1993: assembly code, five hand-drawn fonts, and no internet. Type below. His own code, running in your browser, joins every letter.</p>
    </header>
    <Typewriter />
    <p class="ab-tip">On an English keyboard, press the key where the Arabic letter sits on an Arabic keyboard: <kbd>g</kbd> is <span lang="ar">ل</span>, <kbd>h</kbd> is <span lang="ar">ا</span>, <kbd>j</kbd> is <span lang="ar">ت</span>. <kbd>Shift</kbd>+<kbd>1</kbd> to <kbd>4</kbd> switch italic, bold, underline and double size in the middle of a line, as in his editor. <kbd>Shift</kbd>+<kbd>8</kbd> turns them all off.</p>
  </section>

  <section class="ab-sec" id="service" aria-labelledby="h-service">
    <div class="ab-pair">
    <div class="ab-text">
      <h2 id="h-service">Load it once. Every program can write Arabic.</h2>
      <p class="ab-lead">ARABART is a tiny service that lives in memory. Any program on the PC asks it to draw Arabic with a single call, the way an app today calls a local API.</p>
      <p>Run ARABART.EXE and you get the DOS prompt straight back. But 30,110 bytes of it stay behind in memory, waiting for work. DOS called this a <Term id="tsr">TSR</Term>. Today we would call it a background service.</p>
      <p>To be reachable from any program, Yasser plugged it into something every program already used: the PC's built-in video service, <Term id="int-10h">INT 10h</Term>. Ask that service for ARABART’s own function number, and ARABART answers. Ask for anything else, and ARABART checks it in three instructions and passes it on, untouched.</p>
    </div>
    <Steps
      title="ARABART joins the video service"
      steps={[
        'Run ARABART.EXE once. When it ends, 30,110 bytes of it stay in memory, five fonts included.',
        'It puts its own address in front of the video service, <code>INT 10h</code>, like a new route on a web server that is already running.',
        'A program asks the video service for function <code>36h</code> with the text <code>~gtk ~guvfd</code>. ARABART answers: it joins the letters and draws them.',
        'Any other request, like <code>0Ch</code> for one plain pixel, goes on to the PC’s own video code, as if ARABART were not there. It is middleware that calls <code>next()</code>.',
      ]}
    >
      <svg class="dg" viewBox="0 0 640 366" role="img" aria-labelledby="ab-svc-t">
