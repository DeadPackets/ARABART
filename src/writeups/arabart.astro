<script>
  // One call, then and now: pointing at a line lights its partner in the other window
  const wins = [...document.querySelectorAll<HTMLElement>('[data-pairs]')];
  const light = (p: string | null) => wins.forEach(w => w.querySelectorAll<HTMLElement>('li[data-p]').forEach(li => li.classList.toggle('on', li.dataset.p === p)));
  for (const w of wins) {
    w.querySelectorAll<HTMLElement>('li[data-p]').forEach(li => {
      li.tabIndex = 0;
      for (const ev of ['pointerenter', 'focus']) li.addEventListener(ev, () => light(li.dataset.p!));
      for (const ev of ['pointerleave', 'blur']) li.addEventListener(ev, () => light(null));
    });
  }
</script>
