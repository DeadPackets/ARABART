        <rect class="box" x="10" y="110" width="130" height="44" /><text x="75" y="137" text-anchor="middle">EDITOR.EXE</text>
        <rect class="box" x="10" y="170" width="130" height="44" /><text x="75" y="197" text-anchor="middle">SUN.EXE</text>
        <path class="wire" d="M140 72 C162 72 158 126 178 126" />
        <path class="wire" d="M140 132 H178" />
