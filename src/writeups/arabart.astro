        <rect class="box" x="125" y="10" width="110" height="40" /><text x="180" y="35" text-anchor="middle">EDITOR</text>
        <rect class="box" x="244" y="10" width="110" height="40" /><text x="299" y="35" text-anchor="middle">SUN</text>
        <path class="wire" d="M61 50 C61 80 150 70 150 92" /><path class="wire" d="M180 50 V92" /><path class="wire" d="M299 50 C299 80 210 70 210 92" />
        <rect class="box" x="90" y="94" width="180" height="50" /><text x="180" y="115" text-anchor="middle">INT 10h</text><text class="t-sm" x="180" y="135" text-anchor="middle">the video service</text>
        <g data-s="1+">
          <rect class="box-hi" x="6" y="200" width="348" height="80" />
          <text class="t-bk t-lg" x="180" y="228" text-anchor="middle">ARABART</text>
          <text class="t-bk" x="180" y="256" text-anchor="middle">30,110 bytes. AH = 36h? Draw</text>
        </g>
        <path class="wire arrow" data-s="1" d="M270 120 C340 120 340 300 300 330" />
        <path class="wire-hi arrow" data-s="2+" d="M180 144 V192" /><text class="t-yl" x="190" y="174" data-s="2+">hooked</text>
