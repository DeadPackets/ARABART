---
// HandyMenu, by Yasser Awad (DinarSoft, 2003 to 2008). Facts: HandyMenu.exe 3.6 and 3.7 Build 40 from the archived
// installers (research/dinarsoft/re/handymenu/HOW.md), dinarsoft.com's revision history and details pages, and
// research/career.md. Every toy is built from his own resources and traced from his own ARM code.
import HmMenu from '../components/toys/ds-handymenu/HmMenu.astro';
import HmSwitch from '../components/toys/ds-handymenu/HmSwitch.astro';
import HmPower from '../components/toys/ds-handymenu/HmPower.astro';
import HmCapture from '../components/toys/ds-handymenu/HmCapture.astro';
