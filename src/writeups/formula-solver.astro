---
// FORM_X (1992), Yasser Awad's formula solver: pure assembly, no library, exact decimals. Facts:
// research/artifacts/programs/formx-port/HOW.md, research/programs.md section 3, and FORM_X.EXE (unpacked, code segment 016A).
// Every result on this page comes from src/lib/formx/formx.ts, his program ported routine by routine.
import Listing from '../components/explain/Listing.astro';
import Deep from '../components/explain/Deep.astro';
import ThenNow from '../components/explain/ThenNow.astro';
import FxSolver from '../components/toys/kvc-formx/FxSolver.astro';
import DigitMath from '../components/toys/kvc-formx/DigitMath.astro';
