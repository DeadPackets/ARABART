  @media (max-width: 1000px) {
    .pt-hero, .pt-pair { grid-template-columns: minmax(0, 1fr); }
    .pt-race-note, .pt-pair--r .pt-why { padding-top: 0; margin-top: 0; margin-bottom: 28px; }
