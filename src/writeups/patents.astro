  .pt-prop-t { margin-top: 10px; font-size: 1rem !important; line-height: 1.5 !important; font-style: italic; }
  .pt-prop dl { margin: 14px 0 16px; display: grid; }
  .pt-prop dl div { display: grid; grid-template-columns: 8em minmax(0, 1fr); gap: 12px; padding: 7px 0; border-top: 1px solid var(--w-gray); font-size: 0.9375rem; line-height: 1.45; }
