  .pt-claims { list-style: none; margin: 0 0 8px; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 28px; counter-reset: c; }
  .pt-claims li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 16px; align-items: start; }
  .pt-cn { display: grid; place-items: center; width: 56px; height: 56px; font: 400 32px/1 var(--font-dos); color: var(--w-black); background: var(--w-silver); box-shadow: inset -1px -1px var(--w-black), inset 1px 1px var(--w-white), inset -2px -2px var(--w-gray); }
