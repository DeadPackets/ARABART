  .hd :global(.k-cs [slot='visual']), .hd :global(.k-cs > .hdt-mr), .hd :global(.k-cs > .hdt-ws), .hd :global(.k-cs > .hdt-ink), .hd :global(.k-cs > .hdt-km) { padding: 16px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--rule); }
</style>
