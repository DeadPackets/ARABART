---
// One line of his fault code (MAIN.EXE 2529:01F2) calls slot 34h of whatever object it holds. A gate, a chip and a
// simulation node each answer with their own code. Pick the object, then step the four instructions of the call.
import Window from '../../shell/Window.astro';
import Scrubber from '../Scrubber.astro';
import { hl } from '../../explain/hl';

interface Props { id: string }
const { id } = Astro.props;
const OBJ = [
  { name: 'a gate', cls: 'Gate', vt: '0335', size: 28, fn: '0EFF:0120', says: 'Gate’s own evaluate: the routine you stepped through above.' },
  { name: 'a chip', cls: 'chip logic', vt: '0449', size: 24, fn: '0EFF:06C7', says: 'The chip’s version, for a whole package of gates.' },
  { name: 'a node', cls: 'simulation node', vt: '05E5', size: 70, fn: '1485:0AA7', says: 'The node’s version, for a point where wires meet.' },
];
const ASM = [
  { off: '01F2', code: 'push [bp-0Ch] / push [bp-0Eh]', note: 'this: the object, as a far pointer' },
  { off: '01F8', code: 'les  bx,[bp-0Eh]', note: 'point at the object' },
  { off: '01FB', code: 'mov  bx,es:[bx]', note: 'its first 2 bytes: where its class’s table is' },
  { off: '01FE', code: 'call far [bx+34h]', note: 'slot 34h of that table' },
];
const SAY = [
  'The fault code holds a pointer to some object. It does not know, or need to know, which kind.',
  'Follow the pointer to the object in memory.',
  'Every object made from a class with virtual methods starts with 2 bytes: the address of its class’s table of methods.',
  'One fixed slot of that table holds the address of this class’s own method. One instruction calls it.',
];
const o = OBJ[0];
---

<div class="dtv" id={id} data-dtvcall data-obj={JSON.stringify(OBJ)} data-say={JSON.stringify(SAY)}>
  <div class="dtv-pick" role="radiogroup" aria-label="Which object the pointer holds">
    {OBJ.map((x, i) => <button type="button" role="radio" class="dtv-b" data-i={i} aria-checked={String(i === 0)} tabindex={i === 0 ? 0 : -1}>{x.name}</button>)}
  </div>
  <div class="dtv-grid">
    <Window title="MAIN.EXE  one virtual call" kind="editor" active class="dtv-code">
      <ol class="dtv-asm">{ASM.map((l, i) => <li data-l={i} class="on"><span class="off">{l.off}</span><code set:html={hl(l.code)} /><span class="cm">; {l.note}</span></li>)}</ol>
      <p class="dtv-cpp"><span>In C++</span><code>obj-&gt;evaluate();</code><span>In JavaScript</span><code>obj.evaluate();</code></p>
    </Window>
    <svg class="dg dtv-svg" viewBox="0 0 480 268" role="img" aria-labelledby={`${id}-t`} data-svg>
      <title id={`${id}-t`}>A pointer leads to an object; the object's first 2 bytes lead to its class's table; slot 34h of the table leads to the method that runs.</title>
      <g data-s="0"><rect class="box" x="2" y="24" width="84" height="44" /><text x="44" y="42" text-anchor="middle" class="t-sm">pointer</text><text x="44" y="60" text-anchor="middle">this</text></g>
      <path class="wire-hi arrow" d="M86 46H112" data-s="1" />
      <g data-s="1">
        <rect class="box" x="114" y="10" width="134" height="124" />
        <text x="181" y="32" text-anchor="middle" class="t-cy" data-oname>{o.cls}</text>
        <text x="181" y="96" text-anchor="middle" class="t-sm">its data</text>
        <text x="181" y="120" text-anchor="middle" class="t-sm" data-osize>{o.size} bytes in all</text>
      </g>
      <g data-s="2"><rect class="box-hi" x="124" y="44" width="114" height="28" /><text x="181" y="63" text-anchor="middle" class="t-bk" data-vt>{o.vt}h</text></g>
      <path class="wire-hi arrow" d="M238 58C268 58 262 174 286 174" data-s="2" />
      <g data-s="2">
        <rect class="box" x="288" y="10" width="190" height="212" />
        <text x="383" y="32" text-anchor="middle" class="t-cy">the class’s table</text>
        {['00h', '04h', '…', '30h', '34h', '38h', '…'].map((s, k) => <g data-s={s === '34h' ? '3' : undefined}><rect class={s === '34h' ? 'box-hi' : 'box'} x="298" y={44 + k * 24} width="170" height="20" /><text x="308" y={59 + k * 24} class={s === '34h' ? 't-bk' : 't-sm'}>{s}</text>{s === '34h' && <text x="460" y={59 + k * 24} text-anchor="end" class="t-bk" data-fn>{o.fn}</text>}</g>)}
      </g>
      <path class="wire-hi arrow" d="M383 222V238" data-s="3" />
      <g data-s="3"><rect class="box-ink" x="114" y="240" width="364" height="26" /><text x="296" y="258" text-anchor="middle" class="t-bk" data-fsay>runs {o.fn}</text></g>
    </svg>
  </div>
  <p class="dtv-say" aria-live="polite" data-step-say>{SAY[3]} For {o.name}, that is {o.says}</p>
  <Scrubber n={4} at={3} label="Step through the call" />
</div>

<style is:global>
  .dtv { display: grid; gap: 16px; }
  .dtv-pick { display: flex; flex-wrap: wrap; gap: 6px; }
  .dtv-b { min-height: 44px; padding: 0 16px; font: 600 1rem/1 var(--sans); color: var(--ink); background: var(--surface-2); border: 0; box-shadow: inset 0 0 0 1px var(--accent-2); cursor: pointer; }
  .dtv-b[aria-checked='true'] { background: var(--accent); color: var(--surface); box-shadow: none; }
  .dtv-b:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .dtv-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px 24px; align-items: center; }
  .dtv-asm { display: grid; margin: 0 !important; padding: 0 !important; list-style: none !important; font: 500 clamp(12px, 0.25vw + 9.5px, 13.5px)/1.85 var(--font-code); }
  .dtv-asm li { display: grid; grid-template-columns: 4.4ch 1fr; gap: 0 1.2ch; padding: 0 8px; max-width: none !important; font: inherit !important; color: var(--ink) !important; white-space: pre-wrap; transition: background-color 0.2s; }
  .dtv-asm li::marker { content: none; }
  .dtv-asm .off { color: color-mix(in oklch, var(--accent-2) 75%, transparent); }
  .dtv-asm code { font: inherit; color: inherit; }
  .dtv-asm :is(.op) { color: var(--accent); } .dtv-asm .num { color: var(--accent-2); }
  .dtv-asm .cm { grid-column: 2; color: var(--ink-2); }
  .dtv-asm li.now { background: var(--accent-2); }
  .dtv-asm li.now :is(.off, .cm, .op, .num, code) { color: var(--surface); }
  .dtv-cpp { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; margin: 14px 0 0 !important; padding-top: 12px; border-top: 1px solid var(--rule); max-width: none !important; font-size: 0.875rem !important; }
  .dtv-cpp span { color: var(--ink-2); }
  .dtv-cpp code { color: var(--accent) !important; }
  .dtv-svg { width: 100%; max-width: 520px; justify-self: center; height: auto; overflow: visible; }
  .dtv-svg [data-s] { transition: opacity 0.3s; }
  .dtv.is-live .dtv-svg [data-s]:not(.on) { opacity: 0.12; }
  .dtv-say { margin: 0 !important; min-height: 3.4em; }
  @media (max-width: 860px) { .dtv-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .dtv-svg [data-s], .dtv-asm li { transition: none; } }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { scrubber } from '../scrubber';

  gsap.registerPlugin(DrawSVGPlugin);
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  type O = { name: string; cls: string; vt: string; size: number; fn: string; says: string };

  document.querySelectorAll<HTMLElement & { dtv?: boolean }>('[data-dtvcall]').forEach(root => {
    if (root.dtv) return;
    root.dtv = true;
    const OBJ: O[] = JSON.parse(root.dataset.obj!), SAY: string[] = JSON.parse(root.dataset.say!);
    const parts = [...root.querySelectorAll<SVGElement>('.dtv-svg [data-s]')], lines = [...root.querySelectorAll<HTMLElement>('.dtv-asm li')];
    const say = root.querySelector<HTMLElement>('[data-step-say]')!;
    let o = OBJ[0];
    const go = (i: number, how: string) => {
      for (const p of parts) {
        const on = +p.dataset.s! <= i, was = p.classList.contains('on');
        p.classList.toggle('on', on);
        if (on && !was && how !== 'jump' && !reduce() && p.matches('.wire-hi')) gsap.fromTo(p, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.5, ease: 'power2.inOut' });
      }
      lines.forEach((l, k) => { l.classList.toggle('now', k === i); l.classList.remove('on'); });
      say.textContent = i === 3 ? `${SAY[3]} For ${o.name}, that is ${o.says}` : SAY[i];
    };
    const s = scrubber(root.querySelector<HTMLElement>('[data-scrub]')!, go, { speed: 1.1 });
    const bs = [...root.querySelectorAll<HTMLButtonElement>('.dtv-b')];
    const pick = (b: HTMLButtonElement) => {
      bs.forEach(x => { const on = x === b; x.setAttribute('aria-checked', String(on)); x.tabIndex = on ? 0 : -1; });
      o = OBJ[+b.dataset.i!];
      root.querySelector('[data-oname]')!.textContent = o.cls;
      root.querySelector('[data-vt]')!.textContent = `${o.vt}h`;
      root.querySelector('[data-osize]')!.textContent = `${o.size} bytes in all`;
      root.querySelector('[data-fn]')!.textContent = o.fn;
      root.querySelector('[data-fsay]')!.textContent = `runs ${o.fn}`;
      s.go(0, 'jump');
      if (!reduce()) s.play(); else s.go(3, 'step');
    };
    bs.forEach(b => b.addEventListener('click', () => pick(b)));
    root.querySelector('.dtv-pick')!.addEventListener('keydown', e => {
      const k = (e as KeyboardEvent).key, i = bs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0 || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(k)) return;
      e.preventDefault();
      const b = bs[(i + (k === 'ArrowLeft' || k === 'ArrowUp' ? 2 : 1)) % 3]; b.focus(); pick(b);
    });
    root.classList.add('is-live');
    go(3, 'jump');
  });
</script>
