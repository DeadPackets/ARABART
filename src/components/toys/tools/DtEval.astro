---
// His gate evaluator (MAIN.EXE 0EFF:0120) beside the same logic in C, driving a gate you set up: pick the gate and
// each input (0, 1, X, D or D̄), then step. Steps come from evaluate() in dt-sim.ts, so they always match his rules.
import CodeStepper from '../CodeStepper.astro';
import { evaluate, NAME, Z, O, D, DB, X } from './dt-sim';

interface Props { id: string }
const { id } = Astro.props;
const ASM = [
  { off: '016A', code: 'mov  al,es:[bx+18h]', note: 'controlling value, from the .GAT file' },
  { off: '016F', code: 'call far 0D8D:047A', note: 'NOT: flip it' },
  { off: '0175', code: 'mov  [bp-7],al', note: 'keep the value that decides nothing' },
  { off: '018B', code: 'mov  al,es:[bx+si]', label: 'next', note: 'read one input' },
  { off: '0198', code: 'cmp  al,[bp-8]', note: 'the controlling value?' },
  { off: '019D', code: 'mov  byte ptr [bp-2],1', note: 'yes: decided' },
  { off: '01A6', code: 'cmp  al,[bp-7]', note: 'the other value?' },
  { off: '01AB', code: 'inc  byte ptr [bp-4]', note: 'count it' },
  { off: '01B5', code: 'cmp  ax,6', note: '6 is his code for D' },
  { off: '01BA', code: 'cmp  ax,9', note: '9 is his code for D̄' },
  { off: '01C1', code: 'inc  byte ptr [bp-5]', note: 'count a D' },
  { off: '01C6', code: 'inc  byte ptr [bp-6]', note: 'count a D̄' },
  { off: '01CB', code: 'inc  byte ptr [bp-3]', note: 'anything else: an X' },
  { off: '01CE', code: 'cmp  byte ptr [bp-5],0', note: 'a D and a D̄?' },
  { off: '01DA', code: 'mov  byte ptr [bp-2],1', note: 'then decided too' },
  { off: '01DE', code: 'inc  byte ptr [bp-1]', note: 'next input' },
  { off: '01E8', code: 'cmp  al,[bp-1]', note: 'any left? go to next' },
  { off: '01FF', code: 'mov  al,es:[bx+18h]', label: 'done', note: 'decided: the controlling value' },
  { off: '0214', code: 'mov  al,[bp-7]', note: 'all agreed: the other value' },
  { off: '022D', code: 'mov  byte ptr [bp-8],6', note: 'only D left: D (0233: D̄)' },
  { off: '0258', code: 'or   al,1', note: 'an X with a fault: try here later' },
  { off: '0270', code: 'call far 0EFF:0330', note: 'invert, if this gate inverts' },
];
const C = [
  { code: 'ctrl = gate->ctrl;', note: '0: AND, 1: OR' },
  { code: 'other = NOT(ctrl);' },
  { code: 'decided = agree = nD = nDb = nX = 0;' },
  { code: 'for (i = 0; i < n && !decided; i++) {' },
  { code: '  v = in[i];' },
  { code: '  if (v == ctrl) decided = 1;' },
  { code: '  else if (v == other) agree++;' },
  { code: '  else if (v == D) nD++;' },
  { code: '  else if (v == DBAR) nDb++;' },
  { code: '  else nX++;' },
  { code: '  if (nD && nDb) decided = 1;' },
  { code: '}' },
  { code: 'if (decided) out = ctrl;' },
  { code: 'else if (agree == n) out = other;' },
  { code: 'else if (!nX) out = nD ? D : DBAR;' },
  { code: 'else { frontier = 1; return; }' },
  { code: 'out = invert(out, gate->inv);' },
];
const GATES = [['AND', Z, Z], ['NAND', Z, O], ['OR', O, Z], ['NOR', O, O]] as const;
const VALS = [Z, O, X, D, DB];
const start = { g: 0, ins: [O, D] };
const { steps, out } = evaluate(GATES[start.g][1], GATES[start.g][2], start.ins);
const SHAPE = { and: 'M30 10H62A30 30 0 0 1 62 70H30Z', or: 'M26 10Q44 40 26 70Q76 70 98 40Q76 10 26 10Z' };
---

<div class="dte" data-dteval>
  <CodeStepper id={id} title="MAIN.EXE  his gate evaluator" asm={ASM} c={C} steps={steps} speed={0.7}>
    <div slot="visual" class="dte-vis">
      <div class="dte-pick" hidden data-pickers>
        <div class="dte-grp" role="radiogroup" aria-label="Gate">
          {GATES.map(([n], i) => <button type="button" role="radio" class="dte-b" data-g={i} aria-checked={String(i === start.g)} tabindex={i === start.g ? 0 : -1}>{n}</button>)}
        </div>
        {[0, 1].map(k => (
          <div class="dte-grp" role="radiogroup" aria-label={`Input ${k + 1}`}>
            <span class="dte-lab">in {k + 1}</span>
            {VALS.map(v => <button type="button" role="radio" class="dte-b dte-v" data-in={k} data-v={v} aria-checked={String(start.ins[k] === v)} tabindex={start.ins[k] === v ? 0 : -1}>{NAME[v]}</button>)}
          </div>
        ))}
      </div>
      <div class="dte-stage">
        <svg viewBox="0 0 220 80" class="dte-svg" role="img" aria-label="The gate, its inputs and its output" data-svg>
          <path class="dte-leg" data-leg="0" d="M0 26H30" /><path class="dte-leg" data-leg="1" d="M0 54H30" />
          <text class="dte-in" data-inv="0" x="4" y="20">{NAME[start.ins[0]]}</text>
          <text class="dte-in" data-inv="1" x="4" y="48">{NAME[start.ins[1]]}</text>
          <path class="dte-shape" data-shape d={SHAPE.and} />
          <circle class="dte-bub" data-bub cx="99" cy="40" r="5" style="opacity:0" />
          <path class="dte-leg dte-out-leg" d="M104 40H150" />
          <text class="dte-out" data-out x="160" y="48">{NAME[out]}</text>
        </svg>
        <ol class="dte-count" aria-label="What the routine has counted">
          <li data-c="0"><b>0</b> decide nothing</li>
          <li data-c="1"><b>0</b> D</li>
          <li data-c="2"><b>0</b> D̄</li>
          <li data-c="3"><b>0</b> X</li>
        </ol>
      </div>
    </div>
  </CodeStepper>
</div>

<style is:global>
  .dte-vis { display: grid; gap: 14px; }
  .dte-pick { display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .dte-grp { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .dte-lab { margin-right: 6px; font: 600 0.8125rem/1 var(--font-code); color: var(--accent-2); }
  .dte-b { min-width: 44px; min-height: 44px; padding: 0 10px; font: 700 0.9375rem/1 var(--font-code); color: var(--ink); background: var(--surface-2); border: 0; box-shadow: inset 0 0 0 1px var(--accent-2); cursor: pointer; }
  .dte-b[aria-checked='true'] { background: var(--accent); color: var(--surface); box-shadow: none; }
  .dte-b:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .dte-stage { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 14px 24px; align-items: center; padding: 14px 18px; background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--rule); }
  .dte-svg { width: 100%; max-width: 440px; height: auto; overflow: visible; font-family: var(--font-code); }
  .dte-shape, .dte-bub { fill: var(--surface); stroke: var(--accent-2); stroke-width: 2; }
  .dte-bub { transform-box: fill-box; transform-origin: center; }
  .dte-leg { stroke: var(--accent-2); stroke-width: 2; fill: none; transition: stroke 0.2s; }
  .dte-leg.on { stroke: var(--accent); stroke-width: 4; }
  .dte-in { font-size: 16px; font-weight: 700; fill: var(--ink); }
  .dte-out { font-size: 30px; font-weight: 800; fill: var(--ink-2); }
  .dte-out.done { fill: var(--accent); }
  .dte-count { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; margin: 0 !important; padding: 0 !important; list-style: none !important; }
  .dte-count li { display: flex; align-items: baseline; gap: 8px; max-width: none !important; padding: 6px 8px; font: 500 0.8125rem/1.3 var(--font-code) !important; color: var(--ink-2) !important; background: var(--surface); }
  .dte-count li::marker { content: none; }
  .dte-count b { font-size: 1.25rem; color: var(--ink); }
  .dte-count li.hit { box-shadow: inset 0 0 0 2px var(--accent); }
  .dte-count li.hit b { color: var(--accent); }
  @media (max-width: 640px) { .dte-stage { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .dte-leg { transition: none; } }
</style>

<script>
  import { gsap } from 'gsap';
  import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';
  import { evaluate, NAME, Z, O } from './dt-sim';

  gsap.registerPlugin(MorphSVGPlugin);
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GATES = [[Z, Z], [Z, O], [O, Z], [O, O]];
  const SHAPE = { and: 'M30 10H62A30 30 0 0 1 62 70H30Z', or: 'M26 10Q44 40 26 70Q76 70 98 40Q76 10 26 10Z' };
  type Vis = { i: number; n: number[]; out: number; done: boolean; hit?: string };
  type Stepper = HTMLElement & { stepper?: { load(s: unknown[], at?: number): void; go(i: number): void } };

  document.querySelectorAll<HTMLElement & { dte?: boolean }>('[data-dteval]').forEach(root => {
    if (root.dte) return;
    root.dte = true;
    const cs = root.querySelector<Stepper>('[data-stepper]')!;
    const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
    const legs = [...svg.querySelectorAll<SVGPathElement>('[data-leg]')], counts = [...root.querySelectorAll<HTMLElement>('.dte-count li')];
    const outT = svg.querySelector<SVGTextElement>('[data-out]')!;
    let g = 0, ins = [O, 6];
    const hitIdx: Record<string, number> = { agr: 0, D: 1, X: 3 };

    const draw = (v: Vis) => {
      legs.forEach((l, k) => l.classList.toggle('on', k === v.i && !v.done));
      counts.forEach((li, k) => {
        li.querySelector('b')!.textContent = String(v.n[k]);
        const want = v.hit === 'D' ? (ins[v.i] === 6 ? 1 : 2) : hitIdx[v.hit ?? ''];
        li.classList.toggle('hit', want === k);
      });
      outT.textContent = v.out === 15 ? '?' : NAME[v.out];
      outT.classList.toggle('done', v.done);
    };
    cs.addEventListener('stepper', e => draw((e as CustomEvent).detail.step.vis));

    const shape = () => {
      const [c, inv] = GATES[g], k = reduce() ? 0 : 0.45;
      gsap.to(svg.querySelector('[data-shape]'), { morphSVG: c === Z ? SHAPE.and : SHAPE.or, duration: k, ease: 'power3.inOut' });
      gsap.to(svg.querySelector('[data-bub]'), { opacity: inv === O ? 1 : 0, scale: inv === O ? 1 : 0, duration: k });
      ins.forEach((v, k2) => (svg.querySelector(`[data-inv="${k2}"]`)!.textContent = NAME[v]));
    };
    const reload = () => {
      const [c, inv] = GATES[g];
      const { steps } = evaluate(c, inv, ins);
      shape();
      cs.stepper!.load(steps, steps.length - 1);
    };
    // Radio groups: click or arrow keys
    root.querySelectorAll<HTMLElement>('.dte-grp').forEach(grp => {
      const bs = [...grp.querySelectorAll<HTMLButtonElement>('[role=radio]')];
      const pick = (b: HTMLButtonElement) => {
        bs.forEach(x => { const on = x === b; x.setAttribute('aria-checked', String(on)); x.tabIndex = on ? 0 : -1; });
        if (b.dataset.g) g = +b.dataset.g; else ins[+b.dataset.in!] = +b.dataset.v!;
        reload();
      };
      bs.forEach(b => b.addEventListener('click', () => pick(b)));
      grp.addEventListener('keydown', e => {
        const i = bs.indexOf(document.activeElement as HTMLButtonElement);
        if (i < 0 || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) return;
        e.preventDefault();
        const b = bs[(i + (e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? bs.length - 1 : 1)) % bs.length];
        b.focus(); pick(b);
      });
    });
    root.querySelector<HTMLElement>('[data-pickers]')!.hidden = false;
    // The stepper may have initialised first or after us
    const ready = () => { if (cs.stepper) reload(); else requestAnimationFrame(ready); };
    ready();
  });
</script>
