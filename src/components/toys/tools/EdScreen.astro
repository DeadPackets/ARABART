---
// TEST-EDITOR's window, rebuilt from his own calls in WINGRAPH.CPP (01F6:008A), pixel for pixel on a 640 x 480
// screen. Step through the calls; the pixels each one adds flash. Swap his five palette changes for the standard
// VGA colors to see what they do.
import Window from '../../shell/Window.astro';
import Scrubber from '../Scrubber.astro';
import { Screen, WINDOW } from './EdBgi';
import { fontB64, fontBytes, png } from './EdPng';

interface Props { id?: string }
const { id = 'edscreen' } = Astro.props;
const s = new Screen(fontBytes());
for (const st of WINDOW) for (const op of st.ops) s.run(op);
const final = png(s);
const last = WINDOW.length - 1;
---

<div class="ed-sc" id={id} data-edscreen data-font={fontB64()}>
  <Window title="TEST-EDITOR  640×480" kind="screen" class="ed-sc-win">
    <div class="ed-sc-wrap" data-wrap>
      <div class="ed-sc-stage">
        <img class="ed-sc-img" src={final} width="640" height="480" alt="His TEST-EDITOR window: a blue title bar, a gray system menu box, a File menu with the F underlined, white paper, and a status bar reading INS ON." data-img />
        <canvas class="ed-sc-cv" width="640" height="480" data-cv hidden></canvas>
        <canvas class="ed-sc-cv ed-sc-new" width="640" height="480" data-new aria-hidden="true" hidden></canvas>
      </div>
    </div>
    <div class="ed-sc-pal" aria-label="The 16 colors" data-pal>
      {s.dac.map((_, i) => <span data-c={i} style={`background:rgb(${s.rgb(i).join(',')});color:${s.ink(i)}`} title={`color ${i}`}><b>{i}</b></span>)}
    </div>
  </Window>
  <div class="ed-sc-side">
    <div class="ed-sc-opts" data-opts hidden>
      <button type="button" class="button k-btn" data-pal-btn aria-pressed="true">His 5 colors</button>
      <button type="button" class="button k-btn" data-zoom aria-pressed="false">Zoom 2×</button>
    </div>
    <Window title="WINGRAPH.CPP" kind="editor" active class="ed-sc-code">
      <ol class="ed-sc-calls" data-calls>
        {WINDOW.map((st, i) => (
          <li class:list={{ now: i === last, done: i < last }}><button type="button" data-i={i} aria-label={`Step ${i + 1}`}><span>{i + 1}</span><code>{st.call}</code></button></li>
        ))}
      </ol>
    </Window>
    <p class="ed-sc-say" aria-live="polite" data-say>{WINDOW.length} steps, from his five palette changes to the status bar: the finished window, exactly as his program draws it.</p>
    <Scrubber n={WINDOW.length} at={last} label="Step through his drawing calls" />
  </div>
</div>

<style is:global>
  .ed-sc { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 22px; align-items: start; }
  .ed-sc-wrap { overflow: hidden; }
  .ed-sc-wrap.zoom { overflow: auto; overscroll-behavior: contain; max-height: 70vh; }
  .ed-sc-stage { position: relative; width: 100%; aspect-ratio: 4 / 3; }
  .ed-sc-wrap.zoom .ed-sc-stage { width: 200%; }
  .ed-sc-img, .ed-sc-cv { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
  .ed-sc-new { pointer-events: none; }
  .ed-sc-new.fade { animation: ed-fade 1.4s var(--quart) forwards; }
  @keyframes ed-fade { from { opacity: 1; } to { opacity: 0; } }
  .ed-sc-pal { display: grid; grid-template-columns: repeat(16, minmax(0, 1fr)); gap: 2px; margin-top: 10px; }
  .ed-sc-pal span { position: relative; display: grid; place-items: end center; height: 30px; box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.25); }
  .ed-sc-pal b { font: 600 10px/1 var(--font-code); padding-bottom: 2px; }
  .ed-sc-pal span.his { outline: 2px solid var(--vga-14); outline-offset: 1px; z-index: 1; }
  .ed-sc-side { display: grid; gap: 14px; min-width: 0; }
  .ed-sc-opts { display: flex; flex-wrap: wrap; gap: 10px; }
  .ed-sc-opts .k-btn { min-height: 44px; }
  .ed-sc ol.ed-sc-calls, .writeup .ed-sc ol.ed-sc-calls { display: grid; gap: 1px; margin: 0; padding: 0; list-style: none; max-height: 420px; overflow: auto; overscroll-behavior: contain; }
  .ed-sc-calls li { max-width: none !important; font-size: inherit !important; }
  .ed-sc-calls li::marker { content: none; }
  .ed-sc-calls button { display: grid; grid-template-columns: 2.5ch minmax(0, 1fr); gap: 1ch; width: 100%; min-height: 32px; padding: 4px 8px; text-align: left; font: 500 12px/1.5 var(--font-code); color: var(--ink); background: none; border: 0; cursor: pointer; }
  .ed-sc-calls button span { color: var(--accent-2); }
  .ed-sc-calls code { font: inherit; color: inherit; white-space: pre-wrap; overflow-wrap: anywhere; }
  .ed-sc-calls li:not(.done):not(.now) button { opacity: 0.55; }
  .ed-sc-calls li.now button { background: var(--ink); color: var(--surface); opacity: 1; } /* the page's own text pair: accent-2 under surface text fell to 1.3:1 */
  .ed-sc-calls li.now button :is(span, code) { color: var(--surface); } /* beats .writeup code's accent color */
  .ed-sc-calls button:hover { box-shadow: inset 0 0 0 1px var(--accent-2); }
  .ed-sc-calls button:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .ed-sc-say { margin: 0 !important; min-height: 4.8em; font-size: 1rem !important; line-height: 1.55 !important; }
  @media (max-width: 1100px) { .ed-sc { grid-template-columns: minmax(0, 1fr); } .ed-sc ol.ed-sc-calls, .writeup .ed-sc ol.ed-sc-calls { max-height: 260px; } }
  @media (prefers-reduced-motion: reduce) { .ed-sc-new.fade { animation: none; opacity: 0.85; } }
</style>

<script>
  import { Screen, WINDOW, HIS, DAC, fontFrom } from './EdBgi';
  import { scrubber } from '../scrubber';

  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement & { live?: boolean }>('[data-edscreen]').forEach(root => {
    if (root.live) return;
    root.live = true;
    const font = fontFrom(root.dataset.font!);
    const cv = root.querySelector<HTMLCanvasElement>('[data-cv]')!, nu = root.querySelector<HTMLCanvasElement>('[data-new]')!;
    const ctx = cv.getContext('2d')!, nctx = nu.getContext('2d')!;
    const calls = [...root.querySelectorAll<HTMLLIElement>('[data-calls] li')];
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const palBtn = root.querySelector<HTMLButtonElement>('[data-pal-btn]')!, zoomBtn = root.querySelector<HTMLButtonElement>('[data-zoom]')!;
    const sw = [...root.querySelectorAll<HTMLElement>('[data-pal] span')];
    let his = true, at = WINDOW.length - 1;

    const build = (n: number) => {
      const s = new Screen(font);
      for (let i = 0; i <= n; i++) for (const op of WINDOW[i].ops) if (his || op[0] !== 'pal') s.run(op);
      return s;
    };
    function show(i: number, how: string) {
      at = i;
      const s = build(i), before = i > 0 ? build(i - 1) : null;
      ctx.putImageData(new ImageData(s.rgba(), 640, 480), 0, 0);
      // The pixels this call changed, in yellow, then fading
      const d = nctx.createImageData(640, 480);
      if (before && how !== 'jump') for (let k = 0; k < s.px.length; k++) if (s.px[k] !== before.px[k]) { d.data.set([255, 255, 85, 255], k * 4); }
      nctx.putImageData(d, 0, 0);
      nu.classList.remove('fade'); void nu.offsetWidth; nu.classList.add('fade');
      calls.forEach((li, k) => { li.classList.toggle('now', k === i); li.classList.toggle('done', k < i); });
      // not on the first draw: that would scroll the whole page down to this toy
      if (how !== 'jump') calls[i].querySelector('button')!.scrollIntoView({ block: 'nearest', behavior: reduce() ? 'auto' : 'smooth', inline: 'nearest' });
      say.textContent = WINDOW[i].say;
      const changed = i >= 0 && his;
      sw.forEach((el, k) => {
        el.style.background = `rgb(${s.rgb(k).join(',')})`;
        el.style.color = s.ink(k);
        el.classList.toggle('his', changed && HIS.some(h => h[0] === k));
      });
    }
    const scrub = scrubber(root.querySelector<HTMLElement>('[data-scrub]')!, show, { speed: 0.9 });
    calls.forEach((li, k) => li.querySelector('button')!.addEventListener('click', () => { scrub.pause(); scrub.go(k, 'step'); }));
    palBtn.addEventListener('click', () => {
      his = !his;
      palBtn.setAttribute('aria-pressed', String(his));
      palBtn.textContent = his ? 'His 5 colors' : 'Standard VGA colors';
      show(at, 'jump');
      say.textContent = his ? 'His palette: pure red, true white, Windows’ two grays and a deeper blue.' : 'The standard VGA colors: the same drawing calls, but the blue is brighter, the grays are different, and the cursor’s color 12 would be pink.';
    });
    zoomBtn.addEventListener('click', () => {
      const on = zoomBtn.getAttribute('aria-pressed') !== 'true';
      zoomBtn.setAttribute('aria-pressed', String(on));
      root.querySelector('[data-wrap]')!.classList.toggle('zoom', on);
    });
    root.querySelector<HTMLImageElement>('[data-img]')!.hidden = true;
    cv.hidden = nu.hidden = false;
    root.querySelector<HTMLElement>('[data-opts]')!.hidden = false;
    show(at, 'jump');
    void DAC;
  });
</script>
