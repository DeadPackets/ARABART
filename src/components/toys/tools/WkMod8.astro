---
// His x mod 8, six instructions found in WINKEY, ARABART 4.15, ARAB-ART 7.15 and PESM: pick any x, then step the
// bits as they fall out of DX, land reversed in BX, and come back the right way round through his 8-byte table.
import CodeStepper from '../CodeStepper.astro';
import { mod8Steps, REV } from './wk.ts';

const X0 = 300;
const steps = mod8Steps(X0);
const end = steps[steps.length - 1];
const bits = (v: number, n: number) => v.toString(2).padStart(n, '0').split('');
const ASM = [
  { off: '02F4', code: 'mov  cx,3', note: '3 times' },
  { off: '02F7', code: 'xor  bx,bx', note: 'BX = 0' },
  { off: '02F9', label: 'rev', code: 'shr  dx,1', note: 'a bit falls out' },
  { off: '02FB', code: 'rcl  bx,1', note: 'into BX' },
  { off: '02FD', code: 'loop rev' },
  { off: '02FF', code: 'add  di,dx', note: 'x ÷ 8: the byte' },
  { off: '0301', code: 'mov  cl,cs:[bx+033Dh]', note: 'x mod 8' },
  { off: '033D', code: 'db   00,04,02,06, 01,05,03,07', note: 'his table' },
];
const C = [
  { code: 'unsigned r = 0, carry;' },
  { code: 'for (int i = 0; i < 3; i++) {' },
  { code: '  carry = x & 1;  x >>= 1;', note: 'shr' },
  { code: '  r = (r << 1) | carry;', note: 'rcl' },
  { code: '}' },
  { code: 'int byte = x;', note: 'now x / 8' },
  { code: 'int bit = TABLE[r];', note: 'his table' },
  { code: '// the textbook way: x >> 3, x & 7' },
];
---

<div class="wk-m8" data-wkmod8>
  <label class="wk-m8-in" hidden>
    <span>Pick a pixel: <b>x =</b></span>
    <input type="range" min="0" max="639" step="1" value={X0} aria-label="x, from 0 to 639" data-range />
    <input type="number" min="0" max="639" step="1" value={X0} inputmode="numeric" aria-label="x as a number" data-num />
  </label>
  <CodeStepper id="wk-mod8" title="WINKEY.EXE  x ÷ 8 and x mod 8" asm={ASM} c={C} steps={steps} speed={0.5}>
    <div slot="visual" class="wk-m8-vis" data-wkmod8-vis>
      <div class="wk-m8-row" aria-hidden="true">
        <span class="wk-m8-grp"><span class="wk-m8-lab">DX</span>
        <span class="wk-m8-cells" data-dx>{bits(end.dx, 10).map(b => <i class={b === '1' ? 'one' : ''}>{b}</i>)}</span></span>
        <span class="wk-m8-grp"><span class="wk-m8-lab">CF</span>
        <span class="wk-m8-cells wk-m8-cf" data-cf><i>·</i></span></span>
        <span class="wk-m8-grp"><span class="wk-m8-lab">BX</span>
        <span class="wk-m8-cells wk-m8-bx" data-bx>{bits(end.bx, 3).map(b => <i class={b === '1' ? 'one' : ''}>{b}</i>)}</span></span>
      </div>
      <div class="wk-m8-table" aria-hidden="true">
        <span class="wk-m8-lab">033Dh</span>
        {REV.map((v, i) => <span class:list={['wk-m8-t', { on: end.done && i === end.bx }]} data-t={i}><b>{v}</b><small>{i.toString(2).padStart(3, '0')}</small></span>)}
      </div>
      <div class="wk-m8-line" aria-hidden="true">
        <span class="wk-m8-lab">row</span>
        <span class="wk-m8-bar" data-bar><i style={`left:${((X0 >> 3) / 80) * 100}%`}></i></span>
      </div>
      <p class="wk-m8-out" data-out aria-live="polite">x = <b>{X0}</b>: byte <b>{X0 >> 3}</b> of the row, pixel <b>{X0 & 7}</b> inside it. In JavaScript: <code>x &gt;&gt; 3</code> and <code>x &amp; 7</code>.</p>
    </div>
  </CodeStepper>
</div>

<style is:global>
  .wk-m8 { display: grid; gap: 16px; }
  .wk-m8-in { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; font: 500 1rem/1.4 var(--sans); color: var(--ink); }
  .wk-m8-in b { color: var(--accent); font-family: var(--font-code); }
  .wk-m8-in input[type='range'] { flex: 1 1 220px; min-width: 0; height: 44px; accent-color: var(--accent); }
  .wk-m8-in input[type='number'] { width: 7ch; height: 44px; padding: 0 8px; font: 600 1rem/1 var(--font-code); color: var(--ink); background: var(--surface-2); border: 0; box-shadow: inset 0 0 0 1px var(--accent-2); }
  .wk-m8-in input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wk-m8-vis { display: grid; gap: 14px; padding: 16px; background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--rule); container-type: inline-size; }
  .wk-m8-row, .wk-m8-line { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .wk-m8-grp { display: flex; align-items: center; gap: 8px; }
  .wk-m8-table { display: grid; grid-template-columns: auto repeat(8, minmax(0, 44px)); justify-content: start; align-items: center; gap: 4px; }
  .wk-m8-lab { font: 700 12px/1 var(--font-code); color: var(--accent-2); min-width: 3ch; padding-right: 4px; }
  .wk-m8-cells { display: flex; gap: 2px; }
  .wk-m8-cells i { display: grid; place-items: center; width: clamp(18px, 4.5cqw, 30px); height: 34px; font: 700 14px/1 var(--font-code); font-style: normal; color: var(--ink-2); background: var(--surface); box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--accent-2) 45%, transparent); }
  .wk-m8-cells i.one { color: var(--surface); background: var(--accent-2); }
  .wk-m8-cells i.new { background: var(--accent); color: #000; }
  .wk-m8-cells i.gone { opacity: 0.3; }
  .wk-m8-cf i { background: none; box-shadow: inset 0 0 0 1px var(--ink-2); }
  .wk-m8-t { display: grid; justify-items: center; gap: 2px; padding: 4px 0; min-width: 0; background: var(--surface); box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--accent-2) 45%, transparent); }
  .wk-m8-t b { font: 700 15px/1 var(--font-code); color: var(--ink); }
  .wk-m8-t small { font: 500 10px/1 var(--font-code); color: var(--ink-2); }
  .wk-m8-t.on { background: var(--accent); }
  .wk-m8-t.on b, .wk-m8-t.on small { color: #000; }
  .wk-m8-bar { position: relative; flex: 1 1 200px; height: 14px; background: repeating-linear-gradient(90deg, var(--surface) 0 calc(100% / 80 - 1px), color-mix(in oklch, var(--accent-2) 35%, transparent) calc(100% / 80 - 1px) calc(100% / 80)); box-shadow: inset 0 0 0 1px var(--rule); }
  .wk-m8-bar i { position: absolute; top: -3px; bottom: -3px; width: calc(100% / 80); min-width: 3px; background: var(--accent); }
  .wk-m8-out { margin: 0 !important; font-size: 1rem !important; line-height: 1.5 !important; }
  .wk-m8-out b { color: var(--accent); }
</style>

<script>
  import { gsap } from 'gsap';
  import { mod8Steps, reduce, type Mod8Step } from './wk.ts';

  document.querySelectorAll<HTMLElement & { wk?: boolean }>('[data-wkmod8]').forEach(root => {
    if (root.wk) return;
    root.wk = true;
    const vis = root.querySelector<HTMLElement>('[data-wkmod8-vis]')!, cs = root.querySelector<HTMLElement & { stepper?: { load(s: unknown[], at?: number): void } }>('[data-stepper]')!;
    const dxEl = vis.querySelector<HTMLElement>('[data-dx]')!, cfEl = vis.querySelector<HTMLElement>('[data-cf]')!, bxEl = vis.querySelector<HTMLElement>('[data-bx]')!;
    const tabs = [...vis.querySelectorAll<HTMLElement>('[data-t]')], bar = vis.querySelector<HTMLElement>('[data-bar] i')!, out = vis.querySelector<HTMLElement>('[data-out]')!;
    const range = root.querySelector<HTMLInputElement>('[data-range]')!, num = root.querySelector<HTMLInputElement>('[data-num]')!;
    let x = +range.value, last = -1;

    const cells = (el: HTMLElement, v: number, n: number, keep: number, hot: number) => {
      el.innerHTML = v.toString(2).padStart(n, '0').split('').map((b, i) =>
        `<i class="${b === '1' ? 'one' : ''}${i < n - keep ? ' gone' : ''}${i === hot ? ' new' : ''}">${i < n - keep ? '·' : b}</i>`).join('');
    };
    const paint = (s: Mod8Step, i: number) => {
      cells(dxEl, s.dx, 10, 10, -1);
      cfEl.innerHTML = `<i class="${s.cf === 1 ? 'one new' : s.cf === 0 ? 'new' : ''}">${s.cf < 0 ? '·' : s.cf}</i>`;
      cells(bxEl, s.bx, 3, s.nb, s.a === 3 ? 2 : -1);
      tabs.forEach(t => t.classList.toggle('on', s.done && +t.dataset.t! === s.bx));
      bar.style.left = `${((x >> 3) / 80) * 100}%`;
      out.innerHTML = `x = <b>${x}</b>: byte <b>${x >> 3}</b> of the row, pixel <b>${x & 7}</b> inside it. In JavaScript: <code>x &gt;&gt; 3</code> and <code>x &amp; 7</code>.`;
      // The moving bit: it drops out of DX, then slides into BX from the right
      if (!reduce() && i === last + 1) {
        if (s.a === 2) gsap.fromTo(cfEl.firstElementChild, { x: -40, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, ease: 'power2.out' });
        if (s.a === 3) gsap.fromTo(bxEl.lastElementChild, { x: -30, y: -10, opacity: 0 }, { x: 0, y: 0, opacity: 1, duration: 0.35, ease: 'power2.out' });
        if (s.done) gsap.fromTo(tabs[s.bx], { scale: 1.3 }, { scale: 1, duration: 0.4, ease: 'back.out(2)' });
      }
      last = i;
    };
    cs.addEventListener('stepper', e => { const d = (e as CustomEvent).detail; paint(d.step as Mod8Step, d.i); });

    const setX = (v: number) => {
      x = Math.max(0, Math.min(639, Math.round(v || 0)));
      range.value = num.value = String(x);
      const st = mod8Steps(x);
      last = -1;
      cs.stepper?.load(st, st.length - 1);
    };
    range.addEventListener('input', () => setX(+range.value));
    num.addEventListener('change', () => setX(+num.value));
    root.querySelector<HTMLElement>('.wk-m8-in')!.hidden = false;
  });
</script>
