---
// His key function in the CodeStepper, with the machine it runs on: 120 numbers, shuffled by a word, then stepped
// once per letter. Type any 16 letters or pick a preset; the stepper reloads with the new trace.
import Window from '../../shell/Window.astro';
import CodeStepper from '../CodeStepper.astro';
import { KEY_ASM, KEY_C, keyTrace } from './steps';
import { pocketCode } from '../../../lib/dinarsoft/memmaid';

const TEXT = 'YASSERMOHAMEDALI', WORD = 'MemMaid2';
const steps = keyTrace(TEXT, WORD);
const last = steps[steps.length - 1] as { S: number[]; out: string };
const PRESETS = [
  ['YASSERMOHAMEDALI', 'Yasser’s name'],
  ['GIVEAWAYVERSION1', 'GIVEAWAYVERSION1'],
  [pocketCode('730007B6BFA373D1380000050BFE45CE5'), 'A Pocket PC code'],
];
const WORDS = [['MemMaid2', '2.3'], ['MemMaidI', '1.72 and 1.73, device keys'], ['MemMaidII', '1.5a, device keys'], ['MemMaid', '1.x, built-in keys']];
---

<CodeStepper id="mmcs-key" title="MemMaid.exe  the key function" asm={KEY_ASM} c={KEY_C} steps={steps} speed={0.5}>
  <div slot="visual" class="mky" data-mm-key>
    <Window title="Make a key" kind="dialog" active class="mky-in">
      <div class="mky-pre" role="group" aria-label="Letters to scramble">
        {PRESETS.map(([t, l]) => <button type="button" class="button k-btn" data-text={t} aria-pressed={String(t === TEXT)}>{l}</button>)}
      </div>
      <div class="mky-form">
        <label>16 letters <input type="text" data-text-in value={TEXT} maxlength="16" autocapitalize="characters" spellcheck="false" autocomplete="off" /></label>
        <label>Mixed with <select data-word>{WORDS.map(([w, v]) => <option value={w} selected={w === WORD}>{w}  ({v})</option>)}</select></label>
      </div>
    </Window>
    <Window title="120 numbers" kind="panel" class="mky-grid-win">
      <ol class="mky-grid" data-grid aria-label="The 120 numbers after the last step">
        {last.S.map((v, n) => <li data-n={n}>{v}</li>)}
      </ol>
      <div class="mky-rows" aria-live="polite">
        <p><span>in</span>{[...TEXT].map((ch, n) => <b data-in={n}>{ch}</b>)}</p>
        <p class="mky-out"><span>key</span>{[...last.out].map((ch, n) => <b data-out={n} class:list={{ gap: n % 4 === 3 && n < 15 }}>{ch}</b>)}</p>
      </div>
    </Window>
  </div>
</CodeStepper>

<style is:global>
  .mky { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 22px; align-items: start; }
  .mky-pre { display: flex; flex-wrap: wrap; gap: 8px; }
  .mky-form { display: grid; gap: 12px; margin-top: 14px; }
  .mky-form label { display: grid; gap: 4px; font-size: 0.875rem; color: var(--ink-2); }
  .mky-form input, .mky-form select { box-sizing: border-box; width: 100%; min-width: 0; min-height: 44px; padding: 0 10px; font: 600 1rem/1 var(--font-code); color: var(--ink); background: var(--w-white, #fff); border: 1px solid var(--rule); border-radius: 3px; letter-spacing: 0.06em; }
  .mky-form input:focus-visible, .mky-form select:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .mky-grid { display: grid; grid-template-columns: repeat(15, minmax(0, 1fr)); gap: 2px; margin: 0; padding: 0; list-style: none; }
  .mky-grid li { display: grid; place-items: center; aspect-ratio: 1.25; border-radius: 2px; font: 600 clamp(9px, 0.4vw + 6px, 12px)/1 var(--font-code); color: var(--ink-2); background: var(--surface-2); font-variant-numeric: tabular-nums; }
  .mky-grid li.is-i { color: var(--surface); background: var(--accent); }
  .mky-grid li.is-j { color: var(--surface); background: var(--accent-2); }
  .mky-grid li.is-k { color: var(--surface); background: var(--hot); }
  .mky-rows { display: grid; gap: 6px; margin-top: 14px; }
  .mky-rows p { display: flex; flex-wrap: wrap; align-items: center; gap: 3px; margin: 0 !important; }
  .mky-rows span { width: 3em; font-size: 0.8125rem; color: var(--ink-2); }
  .mky-rows b { display: grid; place-items: center; width: 1.6em; height: 1.9em; border-radius: 2px; font: 700 0.9375rem/1 var(--font-code); color: var(--ink); background: var(--surface-2); }
  .mky-rows b.gap { margin-right: 8px; }
  .mky-rows b.is-at { color: var(--surface); background: var(--accent); }
  .mky-out b { color: var(--accent); }
  .mky-out b:empty { background: none; box-shadow: inset 0 0 0 1px var(--rule); }
  @media (max-width: 1023px) { .mky { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .mky-rows span { width: 100%; } .mky-grid { grid-template-columns: repeat(10, minmax(0, 1fr)); } .mky-grid li { font-size: 12px; font-stretch: 87.5%; } .mky-rows b { width: 1.25em; font-size: 0.8125rem; } .mky-rows b.gap { margin-right: 4px; } }
</style>

<script>
  import { gsap } from 'gsap';
  import { keyTrace } from './steps';

  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-mm-key]').forEach(root => {
    const host = root.closest<HTMLElement & { stepper?: { load(s: unknown[], at?: number): void } }>('[data-stepper]')!;
    const cells = [...root.querySelectorAll<HTMLElement>('[data-grid] li')];
    const ins = [...root.querySelectorAll<HTMLElement>('[data-in]')], outs = [...root.querySelectorAll<HTMLElement>('[data-out]')];
    const input = root.querySelector<HTMLInputElement>('[data-text-in]')!, word = root.querySelector<HTMLSelectElement>('[data-word]')!;
    const pres = [...root.querySelectorAll<HTMLButtonElement>('[data-text]')];
    let last = -1;

    host.addEventListener('stepper', e => {
      const { step, how } = (e as CustomEvent).detail as { step: { S: number[]; out: string; i?: number; j?: number; at?: number; mixed?: boolean }; how: string };
      const S = step.S, i = step.i ?? -1, j = step.j ?? -1, k = i < 0 ? -1 : (S[i] + S[j]) % 120;
      cells.forEach((c, n) => {
        if (c.textContent !== String(S[n])) c.textContent = String(S[n]);
        c.classList.toggle('is-i', n === i); c.classList.toggle('is-j', n === j && j !== i); c.classList.toggle('is-k', n === k && k !== i && k !== j);
      });
      outs.forEach((b, n) => { b.textContent = step.out[n] ?? ''; b.classList.toggle('is-at', n === step.at); });
      ins.forEach((b, n) => b.classList.toggle('is-at', n === step.at));
      // The shuffle step: the numbers visibly move
      if (step.mixed && how !== 'jump' && !reduce() && last < 1) gsap.fromTo(cells, { opacity: 0.2, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.5, stagger: { each: 0.004, from: 'random' } });
      last = (step.at as number | undefined) ?? (step.mixed ? 1 : 0);
    });

    const run = (text: string) => {
      const t = text.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 16) || 'A';
      ins.forEach((b, n) => { b.textContent = t[n] ?? ''; b.hidden = n >= t.length; });
      outs.forEach((b, n) => (b.hidden = n >= t.length));
      pres.forEach(p => p.setAttribute('aria-pressed', String(p.dataset.text === t)));
      const steps = keyTrace(t, word.value);
      host.stepper?.load(steps, steps.length - 1);
    };
    pres.forEach(p => p.addEventListener('click', () => { input.value = p.dataset.text!; run(input.value); }));
    input.addEventListener('input', () => run(input.value));
    word.addEventListener('change', () => run(input.value));
  });
</script>
