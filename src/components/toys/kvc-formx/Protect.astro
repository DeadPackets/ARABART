---
// How FORM_X guards his name (FORM_X.EXE, code segment 016A): three blocks that run once and switch themselves off,
// a credit stored scrambled inside the code, and a checksum of block 1 that steers the exit jump.
// Bytes are from the unpacked program: the credit at 0B20, the summed code at 035E-0392 (036E already turned into RET).
import Window from '../../shell/Window.astro';
import Scrubber from '../Scrubber.astro';

const ENC = '20 40 60 80 D9 3B AE 22 87 F9 1A 5E CD 42 80 A6 0C 7F E8 50 BE EC 1B 3B 5B 7B 9B D7 3B 79 AA C3 1D 4F 6F 80 0A 5D B0 F5 48 20 B5 05 4D 8E DB 21 65 85 C6 03 5C 8A'.split(' ').map(h => parseInt(h, 16));
const PATCH: [number, number][] = [[0x0e, 0x62], [0x1f, 0xe3], [0x23, 0xc8], [0x29, 0x68], [0x33, 0x13]];
const SUMS = 'F3 A4 8A 45 01 88 05 3C 24 74 03 47 EB F4 EB B9 C3 1E 0E 1F BE 6E 03 C6 04 C3 BE 0C 0F 80 04 00 80 44 01 00 80 44 02 00 80 44 03 00 BE 2E 0B C6 04 62 BE 3F 0B'.split(' ').map(h => parseInt(h, 16));
const fixed = [...ENC];
for (const [i, v] of PATCH) fixed[i] = v;
const plain: number[] = [];
for (let i = 1; i < 54; i++) { const v = fixed[i] - fixed[i - 1]; plain.push(v < 0 ? (v - 1) & 255 : v); }
const CREDIT = String.fromCharCode(...plain);
const h2 = (b: number) => b.toString(16).toUpperCase().padStart(2, '0');
const N = 3 + 53 + 1;
const data = JSON.stringify({ enc: ENC, patch: PATCH, sums: SUMS }).replace(/</g, '\\u003c');
---

<div class="kxg" data-protect>
  <script type="application/json" data-kxg set:html={data} />
  <Window title="FORM_X.EXE  his name, inside the code" kind="editor" active class="kxg-win">
    <div class="kxg-bytes" data-bytes role="group" aria-label="54 bytes at 0B20 in his code">
      {fixed.map((b, i) => <div class="kxg-b" data-i={i}><span class="kxg-hx">{h2(b)}</span><span class="kxg-ch">{i ? CREDIT[i - 1] : ''}</span></div>)}
    </div>
    <p class="kxg-credit" data-credit aria-live="off"><span>{CREDIT}</span></p>
    <p class="kxg-math" aria-live="polite" data-math>Each letter is its byte minus the stored byte before it.</p>
    <div class="kxg-blocks" aria-label="The three run-once blocks">
      <span class="kxg-blk" data-blk="1">Block 1 · 036E <b data-op>RET</b></span>
      <span class="kxg-blk" data-blk="2">Block 2 · 0A6F <b data-op>RET</b></span>
      <span class="kxg-blk" data-blk="3">Block 3 · 0B73 <b data-op>RET</b></span>
    </div>
    <Scrubber n={N} at={N - 1} label="Step through the unscrambling" />
  </Window>

  <Window title="BLOCK 3  the checksum that steers the exit" kind="dialog" class="kxg-sum-win">
    <p class="kxg-lead">Block 3 adds up these 53 bytes of code, block 1 included, as 52 overlapping words. It adds <code>A517h</code> and writes the total into the exit jump. Tap any byte to change it.</p>
    <div class="kxg-sums" role="group" aria-label="The 53 summed bytes, 035E to 0392. Arrow keys move between them." data-sums>
      <div class="kxg-sums-row">
        {SUMS.map((b, i) => <button type="button" class:list={['kxg-s', { b1: i >= 16 }]} data-i={i} tabindex={i ? -1 : 0} aria-label={`Byte ${(0x35e + i).toString(16).toUpperCase()}: ${h2(b)}`} aria-pressed="false">{h2(b)}</button>)}
      </div>
    </div>
    <p class="kxg-sum-key"><span class="kxg-k0">formula copier</span> <span class="kxg-k1">block 1</span></p>
    <dl class="kxg-out">
      <div><dt>Sum</dt><dd data-sum>582Eh</dd></div>
      <div><dt>+ A517h</dt><dd data-tot>FD45h</dd></div>
      <div><dt>The jump</dt><dd data-jmp>E9 45 FD</dd></div>
      <div><dt>Lands at</dt><dd data-to>0C5B</dd></div>
    </dl>
    <p class="kxg-verdict" aria-live="polite" data-verdict><b>0C5B: his exit.</b> It writes his credit, with his name and the year 1992, straight onto the screen, then ends the program.</p>
    <button type="button" class="button k-btn" data-reset>Put every byte back</button>
  </Window>
</div>

<style>
  .kxg { display: grid; gap: 30px; min-width: 0; }
  .kxg-bytes { display: grid; grid-template-columns: repeat(18, minmax(0, 1fr)); gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxg-bytes .kxg-b { display: grid; grid-template-rows: auto auto; justify-items: center; gap: 2px; padding: 4px 0; background: var(--surface-2); transition: background-color 0.2s; }
  .kxg-hx { font: 600 clamp(9px, 1vw, 12px)/1 var(--font-code); color: var(--ink-2); }
  .kxg-ch { min-height: 1.1em; font: 400 16px/1 var(--font-dos); color: var(--vga-15); white-space: pre; }
  .kxg-bytes .kxg-b.patched { background: var(--vga-4); }
  .kxg-bytes .kxg-b.patched .kxg-hx { color: var(--vga-15); }
  .kxg-bytes .kxg-b.now { outline: 2px solid var(--accent); outline-offset: -2px; }
  .kxg-bytes .kxg-b.prev { box-shadow: inset 0 -3px 0 var(--accent-2); }
  .kxg-bytes .kxg-b.dec .kxg-hx { color: var(--accent); }
  .kxg-bytes .kxg-b:first-child .kxg-ch { color: var(--ink-2); }
  .kxg-credit { margin: 18px 0 0; padding: 10px 14px; min-height: 2.4em; font: 400 clamp(16px, 2.2vw, 24px)/1.3 var(--font-dos); color: var(--vga-14); background: var(--vga-0); white-space: pre-wrap; overflow-wrap: anywhere; }
  .kxg-math { margin: 12px 0 0; min-height: 3em; font: 500 0.9375rem/1.5 var(--font-code); color: var(--ink); }
  .kxg-math :global(b) { color: var(--accent); }
  .kxg-blocks { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 18px; }
  .kxg-blk { padding: 6px 10px; font: 600 12px/1.4 var(--font-code); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--rule); }
  .kxg-blk b { margin-left: 4px; color: var(--vga-0); background: var(--vga-14); padding: 0 4px; }
  .kxg-blk:not(.off) b { visibility: hidden; }
  .kxg-blk.off { color: var(--ink); }
  .kxg-lead { margin: 0 0 14px; font-size: 0.9375rem; line-height: 1.55; color: var(--ink); max-width: 70ch; }
  .kxg-lead code { font: 600 0.9em var(--font-code); color: var(--accent); }
  .kxg-sums-row { display: grid; grid-template-columns: repeat(18, minmax(0, 1fr)); gap: 3px; }
  .kxg-s { min-width: 0; min-height: 34px; padding: 0; font: 600 clamp(10px, 1vw, 12px)/1 var(--font-code); color: var(--vga-0); background: var(--vga-7); border: 0; cursor: pointer; }
  .kxg-s.b1 { background: oklch(0.86 0.06 195); }
  .kxg-s[aria-pressed='true'] { background: var(--vga-12); color: var(--vga-15); }
  .kxg-s:focus-visible { outline: 2px solid var(--vga-1); outline-offset: 1px; position: relative; z-index: 1; }
  .kxg-sum-key { display: flex; gap: 12px; margin: 8px 0 0; font: 600 11px/1 var(--font-code); }
  .kxg-sum-key span { padding: 4px 6px; color: var(--vga-0); }
  .kxg-k0 { background: var(--vga-7); box-shadow: inset 0 0 0 1px var(--vga-0); }
  .kxg-k1 { background: oklch(0.86 0.06 195); }
  .kxg-out { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 16px 0 0; }
  .kxg-out div { padding: 8px 10px; background: var(--surface-2); }
  .kxg-out dt { font: 600 11px/1.3 var(--font-code); color: var(--ink-2); }
  .kxg-out dd { margin: 4px 0 0; font: 700 1.125rem/1.2 var(--font-code); color: var(--ink); font-variant-numeric: tabular-nums; }
  .kxg-verdict { margin: 14px 0; min-height: 3em; font-size: 0.9375rem; line-height: 1.55; color: var(--ink); }
  .kxg-verdict :global(b) { color: var(--ink); }
  .kxg-verdict.bad :global(b) { color: var(--vga-4); }
  @media (max-width: 760px) {
    .kxg-bytes, .kxg-sums-row { grid-template-columns: repeat(9, minmax(0, 1fr)); }
    .kxg-s { min-height: 44px; }
    .kxg-out { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .kxg-bytes .kxg-b { transition: none; } }
</style>

<script>
  import { gsap } from 'gsap';
  import { scrubber, type How } from '../scrubber';

  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const h2 = (b: number) => b.toString(16).toUpperCase().padStart(2, '0');
  const h4 = (w: number) => w.toString(16).toUpperCase().padStart(4, '0');

  document.querySelectorAll<HTMLElement>('[data-protect]').forEach(root => {
    const { enc, patch, sums } = JSON.parse(root.querySelector('[data-kxg]')!.textContent!) as { enc: number[]; patch: [number, number][]; sums: number[] };
    const lis = [...root.querySelectorAll<HTMLElement>('[data-bytes] .kxg-b')];
    const credit = root.querySelector<HTMLElement>('[data-credit] span')!, math = root.querySelector<HTMLElement>('[data-math]')!;
    const blk = (n: number) => root.querySelector<HTMLElement>(`[data-blk="${n}"]`)!;
    const fixed = [...enc];
    for (const [i, v] of patch) fixed[i] = v;
    const dec = (b: number[], i: number) => { const v = b[i] - b[i - 1]; return v < 0 ? (v - 1) & 255 : v; };
    const show = (c: number) => (c >= 32 && c < 127 ? String.fromCharCode(c) : '·');

    // Step 0 the stored bytes; 1 block 1 fixes five; 2 block 1 turns off; 3 block 2 turns off; 4.. one letter each
    function go(i: number, how: How) {
      const patched = i >= 1, bytes = patched ? fixed : enc, letters = Math.max(0, i - 3);
      lis.forEach((li, k) => {
        li.querySelector('.kxg-hx')!.textContent = h2(bytes[k]);
        li.classList.toggle('patched', patched && patch.some(([p]) => p === k) && i < 4);
        li.querySelector('.kxg-ch')!.textContent = k && k <= letters ? show(dec(fixed, k)) : '';
        li.classList.toggle('dec', k > 0 && k <= letters);
        li.classList.toggle('now', i >= 4 && k === letters);
        li.classList.toggle('prev', i >= 4 && k === letters - 1);
      });
      blk(1).classList.toggle('off', i >= 2);
      blk(2).classList.toggle('off', i >= 3);
      blk(3).classList.toggle('off', i >= 3 + 53);
      credit.textContent = Array.from({ length: letters }, (_, k) => show(dec(fixed, k + 1))).join('');
      if (i === 0) math.innerHTML = 'In the file, his name is 54 bytes of nonsense, hidden among his instructions.';
      else if (i === 1) math.innerHTML = 'The first time you type a value, <b>block 1</b> runs. It changes 5 of these bytes. Without it, five letters come out wrong.';
      else if (i === 2) math.innerHTML = 'Then block 1 writes <b>RET</b>, “return”, over its own first byte. It can never run again.';
      else if (i === 3) math.innerHTML = '<b>Block 2</b> switches itself off the same way, then unscrambles the bytes one by one.';
      else {
        const k = letters, v = dec(fixed, k), borrow = fixed[k] < fixed[k - 1];
        math.innerHTML = `<b>${h2(fixed[k])}</b> − <b>${h2(fixed[k - 1])}</b>${borrow ? ' − 1 (it borrowed)' : ''} = <b>${h2(v)}</b>, the letter “${show(v)}”.${k === 53 ? ' Done: block 3 now switches itself off too, and checks the code below.' : ''}`;
      }
      if (how !== 'jump' && how !== 'scrub' && !reduce() && i >= 4) gsap.fromTo(lis[letters].querySelector('.kxg-ch'), { y: -8, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: 'expo.out' });
    }
    const n = 3 + 53 + 1;
    scrubber(root.querySelector<HTMLElement>('[data-scrub]')!, go, { speed: 0.09 }).go(n - 1, 'jump');

    // The checksum: 52 words, one byte apart, plus A517h, added into the jump at 0F13; the jump ends at 0F16
    const cells = [...root.querySelectorAll<HTMLButtonElement>('.kxg-s')];
    const cur = [...sums];
    const out = (s: string) => root.querySelector<HTMLElement>(`[data-${s}]`)!;
    function sum() {
      let s = 0;
      for (let k = 0; k < 52; k++) s = (s + cur[k] + 256 * cur[k + 1]) & 0xffff;
      const tot = (s + 0xa517) & 0xffff, to = (0x0f16 + tot) & 0xffff, ok = to === 0x0c5b;
      out('sum').textContent = `${h4(s)}h`;
      out('tot').textContent = `${h4(tot)}h`;
      out('jmp').textContent = `E9 ${h2(tot & 255)} ${h2(tot >> 8)}`;
      out('to').textContent = h4(to);
      const v = out('verdict');
      v.classList.toggle('bad', !ok);
      v.innerHTML = ok
        ? '<b>0C5B: his exit.</b> It writes his credit, with his name and the year 1992, straight onto the screen, then ends the program.'
        : `<b>${h4(to)}: not his exit.</b> One changed byte and the jump lands somewhere else. Remove the protection and the program no longer ends cleanly.`;
      if (!reduce()) gsap.fromTo(out('to'), { scale: 1.25 }, { scale: 1, duration: 0.4, ease: 'expo.out' });
    }
    cells.forEach((c, k) => c.addEventListener('click', () => {
      const on = c.getAttribute('aria-pressed') !== 'true';
      cur[k] = on ? (sums[k] + 1) & 255 : sums[k];
      c.setAttribute('aria-pressed', String(on));
      c.textContent = h2(cur[k]);
      c.setAttribute('aria-label', `Byte ${(0x35e + k).toString(16).toUpperCase()}: ${h2(cur[k])}${on ? ', changed' : ''}`);
      sum();
    }));
    root.querySelector('[data-sums]')!.addEventListener('keydown', e => {
      const ev = e as KeyboardEvent, k = cells.indexOf(document.activeElement as HTMLButtonElement);
      if (k < 0) return;
      const cols = getComputedStyle(cells[0].parentElement!).gridTemplateColumns.split(' ').length;
      const to = { ArrowRight: k + 1, ArrowLeft: k - 1, ArrowDown: k + cols, ArrowUp: k - cols, Home: 0, End: cells.length - 1 }[ev.key];
      if (to === undefined) return;
      ev.preventDefault();
      const t = Math.max(0, Math.min(cells.length - 1, to));
      cells.forEach((c, j) => (c.tabIndex = j === t ? 0 : -1));
      cells[t].focus();
    });
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      cells.forEach((c, k) => { cur[k] = sums[k]; c.setAttribute('aria-pressed', 'false'); c.textContent = h2(sums[k]); });
      sum();
    });
  });
</script>
