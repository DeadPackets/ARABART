---
// Bits you can flip, grouped and labeled, with decimal and hex updating live.
// Event: 'bitfield' { value, bit } bubbles from the root on every change. API: root.bitfield.value, root.bitfield.set(v, quiet).
import '../../styles/explain.css';

interface Group { bits: number; label: string; tone?: 'a' | 'b' | 'c' }
interface Props { label: string; bits?: number; value?: number; groups?: Group[]; readonly?: boolean; id?: string; class?: string; size?: 'lg' | 'sm' }
const { label, bits = 8, value = 0, groups = [{ bits, label: '' }], readonly = false, id, class: cls, size = 'lg' } = Astro.props;

const hex = (v: number) => (v >>> 0).toString(16).toUpperCase().padStart(Math.ceil(bits / 4), '0');
let at = bits;
const G = groups.map(g => ({ ...g, idx: Array.from({ length: g.bits }, () => --at) }));
const on = (b: number) => Math.floor(value / 2 ** b) % 2 === 1;
---

<div class:list={['k-bits', `k-bits--${size}`, cls, { 'is-ro': readonly }]} id={id} data-bitfield data-bits={bits} data-value={value} role="group" aria-label={label}>
  <div class="k-bits-row">
    {G.map(g => (
      <div class="k-bits-g" data-tone={g.tone} style={`--n:${g.bits}`}>
        <div class="k-bits-cells">
          {g.idx.map(b => readonly ? (
            <span class="k-bit" data-b={b} data-on={String(on(b))} aria-hidden="true">{on(b) ? 1 : 0}</span>
          ) : (
            <button type="button" class="k-bit" data-b={b} aria-pressed={String(on(b))} aria-label={`Bit ${b}${g.label ? `, ${g.label}` : ''}`} tabindex={b === bits - 1 ? 0 : -1}>
              <span class="k-bit-v">{on(b) ? 1 : 0}</span><span class="k-bit-i" aria-hidden="true">{b}</span>
            </button>
          ))}
        </div>
        {g.label && <span class="k-bits-lab">{g.label}</span>}
      </div>
    ))}
  </div>
  <p class="k-bits-out" aria-live="polite">
    <span>Decimal <b data-dec>{value.toLocaleString('en-US')}</b></span>
    <span>Hex <b data-hex>{hex(value)}h</b></span>
  </p>
</div>

<style>
  .k-bits { --cell: 44px; container-type: inline-size; }
  .k-bits--sm { --cell: clamp(14px, calc((100cqw - 40px) / 32), 24px); }
  .k-bits-row { display: flex; flex-wrap: wrap; gap: 10px 8px; }
  .k-bits-g { display: grid; gap: 6px; }
  .k-bits-cells { display: flex; gap: 3px; perspective: 400px; }
  .k-bit {
    position: relative;
    width: var(--cell);
    height: calc(var(--cell) * 1.15);
    display: grid;
    place-items: center;
    padding: 0;
    font: 700 max(12px, calc(var(--cell) * 0.42))/1 var(--font-code);
    color: var(--ink-2);
    background: var(--surface-2);
    border: 0;
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--accent-2) 45%, transparent);
    transform-style: preserve-3d;
  }
  button.k-bit { cursor: pointer; }
  .k-bit-i { position: absolute; bottom: 2px; right: 3px; font: 500 12px/1 var(--font-code); font-stretch: 75%; color: color-mix(in oklch, currentColor 70%, transparent); }
  .k-bit[aria-pressed='true'], .k-bit[data-on='true'] { color: var(--surface); background: var(--accent-2); box-shadow: none; }
  [data-tone='a'] .k-bit:is([aria-pressed='true'], [data-on='true']) { background: var(--ink); }
  [data-tone='c'] .k-bit:is([aria-pressed='true'], [data-on='true']) { background: var(--accent); }
  [data-tone='a'] .k-bit:not([aria-pressed='true'], [data-on='true']) { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--ink) 55%, transparent); }
  button.k-bit:hover { outline: 2px solid var(--accent); outline-offset: -2px; }
  button.k-bit:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; z-index: 1; }
  .k-bits-lab { width: calc(var(--n) * var(--cell) + (var(--n) - 1) * 3px); font: 600 12px/1.3 var(--font-code); color: var(--accent-2); border-top: 2px solid currentColor; padding-top: 4px; }
  [data-tone='a'] .k-bits-lab { color: var(--ink); }
  [data-tone='c'] .k-bits-lab { color: var(--accent); }
  .k-bits--sm .k-bit { height: calc(var(--cell) * 1.4); }
  .k-bits--sm .k-bits-lab { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .k-bits-out { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: 12px; font: 500 0.8125rem/1.4 var(--font-code); color: var(--ink-2); }
  .k-bits-out b { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }
  /* A container query styles the container's children, never the container itself */
  @container (max-width: 420px) { .k-bits--lg > .k-bits-row { --cell: clamp(30px, calc((100cqw - 40px) / 8), 44px); } }
</style>

<script>
  import { gsap } from 'gsap';

  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  type BF = { readonly value: number; set(v: number, quiet?: boolean): void };

  document.querySelectorAll<HTMLElement & { bitfield?: BF }>('[data-bitfield]').forEach(root => {
    if (root.bitfield) return;
    const n = +root.dataset.bits!;
    const cells = [...root.querySelectorAll<HTMLElement>('.k-bit')];
    const dec = root.querySelector('[data-dec]')!, hx = root.querySelector('[data-hex]')!;
    let value = +root.dataset.value!;
    const on = (v: number, b: number) => Math.floor(v / 2 ** b) % 2 === 1;

    const set = (v: number, quiet = false, bit?: number) => {
      v = Math.max(0, Math.min(2 ** n - 1, Math.round(v)));
      const old = value;
      value = v;
      for (const c of cells) {
        const b = +c.dataset.b!, now = on(v, b);
        if (c.tagName === 'BUTTON') c.setAttribute('aria-pressed', String(now)); else c.dataset.on = String(now);
        (c.querySelector('.k-bit-v') ?? c).textContent = now ? '1' : '0';
        if (now !== on(old, b) && !reduce()) gsap.fromTo(c, { rotationX: -180 }, { rotationX: 0, duration: 0.5, ease: 'expo.out', overwrite: true });
      }
      dec.textContent = v.toLocaleString('en-US');
      hx.textContent = `${v.toString(16).toUpperCase().padStart(Math.ceil(n / 4), '0')}h`;
      if (!quiet) root.dispatchEvent(new CustomEvent('bitfield', { bubbles: true, detail: { value: v, bit } }));
    };
    root.bitfield = { get value() { return value; }, set };

    root.addEventListener('click', e => {
      const c = (e.target as Element).closest<HTMLButtonElement>('button.k-bit');
      if (!c) return;
      const b = +c.dataset.b!;
      set(on(value, b) ? value - 2 ** b : value + 2 ** b, false, b);
    });
    // One tab stop; arrows move between bits
    root.addEventListener('keydown', e => {
      const c = (e.target as Element).closest<HTMLButtonElement>('button.k-bit');
      if (!c || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
      e.preventDefault();
      const bs = cells as HTMLButtonElement[], k = bs.indexOf(c);
      const to = e.key === 'Home' ? 0 : e.key === 'End' ? bs.length - 1 : Math.max(0, Math.min(bs.length - 1, k + (e.key === 'ArrowRight' ? 1 : -1)));
      bs.forEach((x, j) => (x.tabIndex = j === to ? 0 : -1));
      bs[to].focus();
    });
  });
</script>
