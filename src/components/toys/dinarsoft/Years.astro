---
// DinarSoft as a commit history (git log --graph): the company's own line, one colored line per app from its first
// release to its last, and one row per release, award, honor and milestone, oldest first. Open a row for everything that
// version added, or the magazine's own page for an award. Run reveals the years one by one.
// No JS: every row is there and opens (details/summary); the scrubber stays hidden.
import Window from '../../shell/Window.astro';
import Scrubber from '../Scrubber.astro';
import Cap from './Cap.astro';
import { apps, awards, honors, icon, longDate, type AppId } from '../../../data/dinarsoft';
import './ds.css';

const YEARS = [2002, 2003, 2004, 2005, 2006, 2007, 2008];
const COL: Record<AppId, string> = { memmaid: '#c62828', handyswitcher: '#1f5fbf', handymenu: '#2e7d32', handylauncher: '#a35f00', taptext: '#6a3fb0', hijridate: '#00727d' };
const LV = ['Winner', 'Finalist', 'Nominee'];
const span = Object.fromEntries(apps.map(a => [a.id, [a.releases[0].date, a.releases.at(-1)!.date]])) as Record<AppId, [string, string]>;
const name = (id: AppId) => apps.find(a => a.id === id)!.name;

type Row = { y: number; d: string; app?: AppId; kind: 'rel' | 'aw' | 'hon' | 'co'; node: 'dot' | 'maj' | 'aw' | 'hon' | 'co'; tag: string; msg: string; html?: boolean; date: string; notes?: string[]; aw?: (typeof awards)[number]; link?: string };
const rows: Row[] = [
  { y: 2002, d: '2002-11', kind: 'co', node: 'co', tag: 'DinarSoft', msg: 'Yasser Awad founds DinarSoft Corporation in Kanata, Ontario.', date: 'November 2002' },
  { y: 2006, d: '2006-11-01', kind: 'co', node: 'co', tag: 'DinarSoft', msg: 'A new logo: two red crescents around a red dot.', date: longDate('2006-11-01') },
  { y: 2006, d: '2006-11-15', kind: 'co', node: 'co', tag: 'DinarSoft', msg: 'The new dinarsoft.com goes live, with its own store.', date: longDate('2006-11-15') },
  ...apps.flatMap(a => a.releases.map((r, i) => ({
    y: +r.date.slice(0, 4), d: r.date, app: a.id, kind: 'rel' as const, node: /^\d+\.0$/.test(r.v) ? 'maj' as const : 'dot' as const,
    tag: `${a.name} ${r.v}`, msg: r.notes[0] ?? (i ? 'An update.' : 'The first release.'), date: longDate(r.date), notes: r.notes.slice(1),
  }))),
  ...honors.filter(h => h.date.length > 4).map(h => ({
    y: +h.date.slice(0, 4), d: h.date, app: h.app, kind: 'hon' as const, node: 'hon' as const, tag: 'Honor',
    msg: `<b>${h.by}</b>: ${h.title}, for ${name(h.app)}`, html: true, date: longDate(h.date), link: h.link,
  })),
  // The magazine's awards close each year, the winners first
  ...[...awards].sort((p, q) => p.year - q.year || LV.indexOf(p.level) - LV.indexOf(q.level)).map((w, i) => ({
    y: w.year, d: `${w.year}-12-31~${String(i).padStart(2, '0')}`, app: w.app, kind: 'aw' as const, node: 'aw' as const,
    tag: w.level === 'Winner' ? '★ Winner' : w.level, msg: `<b>${name(w.app)}</b>${w.category ? `, ${w.category}` : ''}`, html: true,
    date: `Best Software Awards ${w.year}`, aw: w,
  })),
].sort((p, q) => p.d.localeCompare(q.d));

// Which lines run past a row: the company's always; an app's from its first release to its last row
const LANES: (AppId | 'co')[] = ['co', ...apps.map(a => a.id)];
const end = Object.fromEntries(apps.map(a => [a.id, rows.filter(r => r.app === a.id).map(r => r.d.slice(0, 10)).sort().at(-1)!])) as Record<AppId, string>;
const lane = (r: Row, k: AppId | 'co') => {
  if (k === 'co') return { st: r.d === '2002-11' ? 'start' : 'mid', node: r.kind === 'co' };
  const d = r.d.slice(0, 10), a = span[k][0], b = end[k], node = r.app === k;
  if (d < a || d > b) return { st: 'none', node: false };
  return { st: d === a && node ? 'start' : d === b && node ? 'end' : 'mid', node };
};
const sum = (y: number) => {
  const n = (f: (r: Row) => boolean, one: string, many: string) => { const k = rows.filter(r => r.y === y && f(r)).length; return k ? `${k} ${k > 1 ? many : one}` : ''; };
  return [n(r => r.kind === 'rel', 'release', 'releases'), n(r => r.aw?.level === 'Winner', 'win', 'wins'), n(r => r.aw?.level === 'Finalist', 'finalist', 'finalists'), n(r => r.aw?.level === 'Nominee', 'nomination', 'nominations')]
    .filter(Boolean).join(' · ') || 'the company is born';
};
const nRel = rows.filter(r => r.kind === 'rel').length;
---

<div class="dsy" data-dsy>
  <Window kind="editor" title={`History: ${nRel} releases, ${awards.length} awards and nominations`} active class="dsy-win">
    <div class="dsy-box" tabindex="0" role="region" aria-label="DinarSoft's history, oldest first">
      {YEARS.map(y => (
        <section class="dsy-year" data-y={y} aria-label={String(y)}>
          <h3 class="dsy-yh"><span>{y}</span><small>{sum(y)}</small></h3>
          <ol class="dsy-list">
            {rows.filter(r => r.y === y).map(r => {
              const more = (r.notes?.length ?? 0) > 0 || r.aw || r.link;
              const head = <>
                <span class={`dsy-tag dsy-tag--${r.kind}${r.aw ? ` dsy-tag--${r.aw.level.toLowerCase()}` : ''}`}>{r.tag}</span>
                {r.html ? <span class="dsy-msg" set:html={r.msg} /> : <span class="dsy-msg">{r.msg}</span>}
                <span class="dsy-when">{r.date}{r.notes?.length ? <b class="dsy-n">+{r.notes.length}</b> : null}</span>
              </>;
              return (
                <li class={`dsy-row dsy-row--${r.kind}`} style={r.app ? `--c:${COL[r.app]}` : undefined}>
                  <span class="dsy-g" aria-hidden="true">
                    {LANES.map(k => { const l = lane(r, k); return <i class:list={['dsy-l', `dsy-l--${l.st}`, l.node && `dsy-node dsy-node--${r.node}`]} style={`--lc:${k === 'co' ? 'var(--ds-ink)' : COL[k]}`}></i>; })}
                  </span>
                  {more ? (
                    <details class="dsy-d">
                      <summary class="dsy-s">{head}</summary>
                      <div class="dsy-more">
                        {r.notes && r.notes.length > 0 && <ul class="dsy-notes">{r.notes.map(n => <li>{n}</li>)}</ul>}
                        {r.aw && r.aw.shots.slice(0, 1).map(s => <Cap shot={s} />)}
                        {r.link && <p><a href={r.link} rel="noopener">See it as the Internet Archive kept it</a></p>}
                      </div>
                    </details>
                  ) : <div class="dsy-s">{head}</div>}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
    <ul class="dsy-key" aria-label="One line per app">
      <li style="--c: var(--ds-ink)"><i></i>DinarSoft</li>
      {apps.map(a => <li style={`--c:${COL[a.id]}`}><img src={icon(a.id).src} width="18" height="18" alt="" /><i></i>{a.name}</li>)}
      <li class="dsy-key-k"><i class="dsy-k-dot"></i>update <i class="dsy-k-dot big"></i>major version <i class="dsy-k-sq"></i>award</li>
    </ul>
    <Scrubber n={YEARS.length} at={YEARS.length - 1} label="Year, from 2002 to 2008" />
  </Window>
</div>

<style>
  .dsy-box { position: relative; max-height: min(640px, 72vh); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; font: 400 0.9375rem/1.45 var(--ds-verdana); }
  .dsy-box:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .dsy-yh { position: sticky; top: 0; z-index: 1; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 8px 12px; background: #eef2fa; border-block: 1px solid #c5d3ea; font: 700 1.0625rem/1.2 var(--ds-verdana); color: var(--ds-ink); letter-spacing: 0; }
  .dsy-yh small { font: 400 0.8125rem/1.2 var(--ds-verdana); color: #4a4a4a; }
  .dsy-list { list-style: none; }

  .dsy-row { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 10px; padding-left: 10px; border-bottom: 1px solid #eef0f4; }
  .dsy-row--aw, .dsy-row--hon { background: #fffdf3; }
  .dsy-row--co { background: #fff5f4; }
  /* The graph: each line runs the full height of its row, so an opened row keeps its lines */
  .dsy-g { display: flex; gap: 6px; }
  .dsy-l { position: relative; width: 12px; }
  .dsy-l::before { content: ''; position: absolute; left: 5px; width: 2px; top: 0; bottom: 0; background: var(--lc); opacity: 0.45; }
  .dsy-l--none::before { display: none; }
  .dsy-l--start::before { top: 20px; }
  .dsy-l--end::before { bottom: auto; height: 20px; }
  .dsy-node::after { content: ''; position: absolute; left: 0; top: 14px; width: 12px; height: 12px; box-sizing: border-box; border-radius: 50%; background: #fff; border: 2.5px solid var(--lc); }
  .dsy-node--maj::after { left: -1px; top: 13px; width: 14px; height: 14px; background: var(--lc); }
  .dsy-node--aw::after { border-radius: 2px; background: #ffef3d; border-color: #1d1dcc; }
  .dsy-node--hon::after { border-radius: 2px; rotate: 45deg; background: #fff3c4; border-color: #8a6100; }
  .dsy-node--co::after { border-radius: 1px; rotate: 45deg; background: var(--ds-red); border-color: var(--ds-red); }

  .dsy-s { display: grid; grid-template-columns: max-content minmax(0, 1fr) max-content; align-items: center; gap: 4px 12px; min-height: 40px; padding: 6px 12px 6px 0; list-style: none; }
  .dsy-s::-webkit-details-marker { display: none; }
  summary.dsy-s { cursor: pointer; }
  summary.dsy-s:hover { background: #f3f7fd; }
  summary.dsy-s:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .dsy-tag { justify-self: start; padding: 2px 8px; border-radius: 10px; font-weight: 700; font-size: 0.8125rem; white-space: nowrap; color: color-mix(in oklch, var(--c) 82%, #000); background: color-mix(in oklch, var(--c) 12%, #fff); }
  .dsy-tag--co { color: #fff; background: var(--ds-red); border-radius: 3px; }
  .dsy-tag--aw, .dsy-tag--hon { border-radius: 3px; }
  .dsy-tag--winner { background: #1d1dcc; color: #ffef3d; }
  .dsy-tag--finalist { background: #8f2238; color: #fff; }
  .dsy-tag--nominee { background: #fff; color: #3d3d3d; box-shadow: inset 0 0 0 1px #8a8a8a; }
  .dsy-tag--hon { background: #fff3c4; color: #5c4100; box-shadow: inset 0 0 0 1px #c9a227; }
  .dsy-msg { color: #1f1f1f; }
  .dsy-msg :global(b) { font-weight: 700; }
  .dsy-when { display: flex; align-items: center; gap: 8px; justify-self: end; font-size: 0.8125rem; color: #5a5a5a; white-space: nowrap; }
  .dsy-n { padding: 0 6px; border-radius: 8px; background: #e6ecf6; color: #1a3f8f; font-size: 0.75rem; }
  details[open] > .dsy-s .dsy-n { background: #1a3f8f; color: #fff; }
  .dsy-more { padding: 2px 12px 14px 0; }
  .dsy-notes { margin: 0 0 0 18px; font-size: 0.9375rem; line-height: 1.5; color: #2a2a2a; }
  .dsy-notes li + li { margin-top: 3px; }
  .dsy-more :global(.dsx-cap) { max-width: 640px; }
  .dsy-more a { color: #1a3f8f; font-size: 0.875rem; }
  details[open] .dsy-more { animation: dsy-open 0.3s var(--expo); }
  @keyframes dsy-open { from { opacity: 0; translate: 0 -4px; } }

  /* Run: the years that have not happened yet are not there; a year that arrives slides in, row by row */
  :global(.dsy.is-live) .dsy-year.later { display: none; }
  .dsy-year.arrive .dsy-row { animation: dsy-in 0.35s var(--quart) both; animation-delay: calc(var(--i, 0) * 40ms); }
  @keyframes dsy-in { from { opacity: 0; translate: -8px 0; } }

  .dsy-key { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; list-style: none; margin: 12px 0 14px; font: 400 0.8125rem/1.6 var(--ds-verdana); color: #3d3d3d; }
  .dsy-key li { display: flex; align-items: center; gap: 6px; }
  .dsy-key li > i:not([class]) { width: 14px; height: 3px; background: var(--c); }
  .dsy-key-k { margin-left: auto; gap: 6px; }
  .dsy-k-dot { width: 10px; height: 10px; border-radius: 50%; border: 2.5px solid #555; background: #fff; }
  .dsy-k-dot.big { width: 13px; height: 13px; background: #555; margin-left: 8px; }
  .dsy-k-sq { width: 11px; height: 11px; border-radius: 2px; border: 2.5px solid #1d1dcc; background: #ffef3d; margin-left: 8px; }

  @media (max-width: 640px) {
    /* the whole window, controls included, fits one phone screen, so Run never plays off screen */
    .dsy-box { max-height: 50vh; }
    .dsy-key { gap: 2px 12px; margin: 8px 0 10px; font-size: 0.75rem; }
    .dsy-g { gap: 2px; }
    .dsy-l { width: 10px; }
    .dsy-l::before { left: 4px; }
    .dsy-node::after { width: 10px; height: 10px; }
    .dsy-node--maj::after { left: -1px; width: 12px; height: 12px; }
    .dsy-s { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .dsy-when { grid-row: 3; justify-self: start; }
    .dsy-key-k { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .dsy-year.arrive .dsy-row, details[open] .dsy-more { animation: none; } }
</style>

<script>
  import { scrubber } from '../scrubber';

  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-dsy]').forEach(root => {
    const box = root.querySelector<HTMLElement>('.dsy-box')!;
    const years = [...root.querySelectorAll<HTMLElement>('.dsy-year')];
    years.forEach(y => y.querySelectorAll<HTMLElement>('.dsy-row').forEach((r, i) => r.style.setProperty('--i', String(i))));
    let at = years.length - 1;
    const show = (i: number, how: string) => {
      years.forEach((y, k) => {
        y.classList.toggle('later', k > i);
        y.classList.toggle('arrive', k === i && k > at && how !== 'jump');
      });
      at = i;
      // Keep the newest year in view, inside the window only (the page does not move)
      if (how !== 'jump') box.scrollTo({ top: years[i].offsetTop, behavior: reduce() ? 'instant' : 'smooth' });
    };
    scrubber(root.querySelector<HTMLElement>('[data-scrub]')!, show, { speed: 1.4 });
    root.classList.add('is-live');
  });
</script>
