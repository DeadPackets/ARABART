---
// One app's versions on a time track. Step or run through them and read what each one added.
// No JS: every version and its notes are listed.
import Window from '../../shell/Window.astro';
import Scrubber from '../Scrubber.astro';
import { longDate, type App } from '../../../data/dinarsoft';
import './ds.css';

interface Props { app: App }
const { app } = Astro.props;
const rs = app.releases;
const t = (d: string) => Date.UTC(+d.slice(0, 4), +d.slice(5, 7) - 1, +d.slice(8, 10) || 1);
const t0 = Date.UTC(2003, 0, 1), t1 = Date.UTC(2009, 0, 1);
const pos = (d: string) => +(((t(d) - t0) / (t1 - t0)) * 100).toFixed(2);
const n = rs.length;
---

<div class="dsv" data-dsv>
  <Window kind="editor" title={`${app.name}.history`} active>
    <div class="dsv-track" aria-hidden="true">
      {[2003, 2004, 2005, 2006, 2007, 2008].map(y => <span class="dsv-yr" style={`left:${pos(`${y}-01-01`)}%`}>{y}</span>)}
      <i class="dsv-line"></i>
      {rs.map((r, i) => <b class="dsv-pin" style={`left:${pos(r.date)}%`} data-i={i}><span>{r.v}</span></b>)}
    </div>
    <ol class="dsv-list">
      {rs.map((r, i) => (
        <li class:list={['dsv-rel', { on: i === n - 1 }]} data-i={i}>
          <p class="dsv-h"><span class="dsx-word">{app.pre}<b>{app.post}</b></span> <b class="dsv-v">{r.v}</b> <span class="dsv-d">{longDate(r.date)}</span></p>
          <ul class="dsv-notes">{r.notes.map(x => <li>{x}</li>)}</ul>
        </li>
      ))}
    </ol>
    {n > 1 && <Scrubber n={n} at={n - 1} label={`${app.name} versions`} />}
  </Window>
</div>

<style>
  .dsv-track { position: relative; height: 64px; margin: 4px 12px 10px; }
  .dsv-line { position: absolute; left: 0; right: 0; top: 34px; height: 2px; background: oklch(0.8 0.02 250); }
  .dsv-yr { position: absolute; top: 0; translate: 0 0; font: 700 0.75rem/1 var(--ds-verdana); color: oklch(0.45 0.03 255); border-left: 1px dotted oklch(0.7 0.02 250); padding-left: 4px; height: 44px; }
  .dsv-pin { position: absolute; top: 28px; width: 14px; height: 14px; translate: -50% 0; border-radius: 50%; background: #fff; border: 3px solid var(--ds-red); transition: background-color 0.25s, scale 0.25s var(--quart); }
  .dsv-pin span { position: absolute; top: 18px; left: 50%; translate: -50% 0; font: 700 0.6875rem/1 var(--ds-verdana); color: var(--ds-ink); white-space: nowrap; opacity: 0; transition: opacity 0.2s; }
  :global(.dsv.is-live) .dsv-pin.past { background: var(--ds-red); }
  :global(.dsv.is-live) .dsv-pin.now { scale: 1.35; background: var(--xp-sel); border-color: var(--xp-sel); }
  :global(.dsv.is-live) .dsv-pin.now span { opacity: 1; }
  .dsv-list { list-style: none; }
  .dsv-rel + .dsv-rel { margin-top: 18px; }
  :global(.dsv.is-live) .dsv-rel:not(.on) { display: none; }
  :global(.dsv.is-live) .dsv-rel.on { animation: dsv-in 0.3s var(--expo); min-height: 9.5em; }
  @keyframes dsv-in { from { opacity: 0; translate: 0 6px; } }
  .dsv-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 1.375rem; }
  .dsv-v { font: 700 1.375rem/1 var(--ds-arial); color: var(--ds-red); }
  .dsv-d { font: 400 0.875rem/1 var(--ds-verdana); color: var(--ds-rust); }
  .dsv-notes { margin: 10px 0 14px 20px; font-size: 1rem; line-height: 1.55; }
  .dsv-notes li + li { margin-top: 3px; }
</style>

<script>
  import { scrubber } from '../scrubber';
  document.querySelectorAll<HTMLElement>('[data-dsv]').forEach(root => {
    const rels = [...root.querySelectorAll<HTMLElement>('.dsv-rel')];
    const pins = [...root.querySelectorAll<HTMLElement>('.dsv-pin')];
    const el = root.querySelector<HTMLElement>('[data-scrub]');
    const show = (i: number) => {
      rels.forEach((r, k) => r.classList.toggle('on', k === i));
      pins.forEach((p, k) => { p.classList.toggle('past', k < i); p.classList.toggle('now', k === i); });
    };
    root.classList.add('is-live');
    if (el) scrubber(el, show, { speed: 1.6 }).go(rels.length - 1, 'jump');
    else show(0);
  });
</script>
