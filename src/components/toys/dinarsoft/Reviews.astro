---
// The reviews, each with the reviewer's own page as the Internet Archive kept it. On the hub, filter by app.
import Window from '../../shell/Window.astro';
import Cap from './Cap.astro';
import { apps, reviews, discs, longDate, type AppId } from '../../../data/dinarsoft';
import './ds.css';

interface Props { only?: AppId }
const { only } = Astro.props;
const list = reviews.filter(r => !only || r.app === only).sort((a, b) => a.date.localeCompare(b.date));
const cds = discs.filter(d => !only || d.app === only);
const counts = apps.map(a => ({ a, n: reviews.filter(r => r.app === a.id).length })).filter(x => x.n);
const name = (id: AppId) => apps.find(a => a.id === id)!.name;
---

<div class="dsr" data-dsr>
  {!only && (
    <div class="dsr-filter" role="group" aria-label="Show reviews of" hidden>
      <button type="button" class="button k-btn" aria-pressed="true" data-f="">All <span>{reviews.length}</span></button>
      {counts.map(({ a, n }) => <button type="button" class="button k-btn" aria-pressed="false" data-f={a.id}>{a.name} <span>{n}</span></button>)}
    </div>
  )}
  <ul class="dsr-wall">
    {list.map(r => (
      <li data-app={r.app}>
        <Window kind="panel" title={r.outlet} class="dsr-card" as="article">
          <p class="dsr-meta">{longDate(r.date)}{r.by && <> · {r.by}</>}{r.where && <> · {r.where}</>}{!only && <> · <b>{name(r.app)}</b></>}</p>
          <h3 class="dsr-t">{r.title}</h3>
          {r.quote && <blockquote class="dsr-q"><p>“{r.quote}”</p></blockquote>}
          {r.rating && <p class="dsr-rate"><span aria-hidden="true">★</span> {r.rating}</p>}
          <div class="dsr-caps">{r.shots.map(s => <Cap shot={s} />)}</div>
        </Window>
      </li>
    ))}
    {cds.map(d => (
      <li data-app={d.app}>
        <Window kind="panel" title="CHIP magazine, Russia" class="dsr-card" as="article">
          <p class="dsr-meta">{longDate(d.date)} · cover disc{!only && <> · <b>{name(d.app)}</b></>}</p>
          <h3 class="dsr-t">{d.title}, on the cover disc</h3>
          <div class="dsr-caps"><Cap shot={d.shot} /></div>
        </Window>
      </li>
    ))}
  </ul>
</div>

<style>
  .dsr-filter { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 22px; }
  .dsr-filter .k-btn { box-shadow: none; font-family: var(--ds-verdana); font-weight: 400; }
  .dsr-filter .k-btn span { margin-left: 4px; font-size: 0.8125rem; }
  .dsr-filter .k-btn[aria-pressed='true'] { background: var(--xp-sel); color: #fff; border-color: #003c74; }
  .dsr-wall { list-style: none; columns: 3 300px; column-gap: 20px; }
  .dsr-wall > li { break-inside: avoid; margin-bottom: 20px; }
  .dsr-wall > li.out { display: none; }
  .dsr-wall > li.in { animation: dsr-in 0.35s var(--expo) both; }
  @keyframes dsr-in { from { opacity: 0; translate: 0 10px; } }
  .dsr-meta { font: 400 0.8125rem/1.45 var(--ds-verdana); color: var(--ink-2); }
  .dsr-meta b { color: var(--ds-rust); font-weight: 700; }
  .dsr-t { margin-top: 6px; font: 700 1.0625rem/1.3 var(--ds-arial); color: var(--ds-ink); letter-spacing: 0; }
  .dsr-q { margin-top: 10px; padding-left: 12px; border-left: 3px solid var(--ds-red); }
  .dsr-q p { font: italic 400 1.0625rem/1.45 Georgia, 'Times New Roman', serif; color: #222; }
  .dsr-rate { margin-top: 8px; font: 700 0.875rem/1.3 var(--ds-verdana); color: #8a6100; }
  .dsr-rate span { color: #e0a100; }
  .dsr-caps { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; margin-top: 12px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dsr]').forEach(root => {
    const bar = root.querySelector<HTMLElement>('.dsr-filter');
    if (!bar) return;
    bar.hidden = false;
    const items = [...root.querySelectorAll<HTMLElement>('.dsr-wall > li')];
    bar.querySelectorAll<HTMLButtonElement>('[data-f]').forEach(b => b.addEventListener('click', () => {
      bar.querySelectorAll('[data-f]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      const f = b.dataset.f;
      items.forEach(li => {
        const on = !f || li.dataset.app === f;
        li.classList.toggle('out', !on);
        li.classList.remove('in');
        if (on) { void li.offsetWidth; li.classList.add('in'); }
      });
    }));
  });
</script>
