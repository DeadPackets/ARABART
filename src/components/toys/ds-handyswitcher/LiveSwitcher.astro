---
// HandySwitcher on a Pocket PC: tap its icon in the top bar, switch to a program, or close one for real.
// The menu is drawn with his own action icons (menu-actions-27.png, from HandySwitcher 2.7) and his five menu colors.
import Window from '../../shell/Window.astro';
import { PROGS } from './hs.ts';
import actions from './menu-actions-27.png';
import bar from './topbar-16.png';

interface Props { solo?: boolean }
const { solo = false } = Astro.props;

const ACTS = [
  { a: 'all', label: 'Close All', icon: 1 },
  { a: 'others', label: 'Close All But Active', icon: 2 },
  { a: 'min', label: 'Minimize All', icon: 3 },
];
const sprite = (n: number, of: number, src: string) => `background-image:url(${src});background-size:${of * 100}% 100%;background-position:${(n * 100) / (of - 1)}% 0`;
---

<div class:list={['hs-live-wrap', { 'is-solo': solo }]} data-hslive-wrap style={`--act:url(${actions.src});--bar:url(${bar.src})`}>
  <Window title="Notes" kind="device" wm="5" theme="teal" icons={['conn', 'ant', 'vol', 'batt']} class="ds-dev hs-live-dev" aria-label="A Pocket PC running HandySwitcher">
    <div class="hs-live" data-hslive>
      <div class="hs-scr" data-scr>
        <div class="hs-today wm-today" data-today hidden>
          <p class="wm-row wm-row--date">Saturday, May 5, 2007</p>
          <p class="wm-row wm-row--owner">Tap here to set owner information</p>
          <p class="wm-row wm-row--mail">No unread messages</p>
          <p class="wm-row wm-row--task">No tasks</p>
          <p class="wm-row wm-row--cal">No upcoming appointments</p>
        </div>
        <div class="hs-app" data-appview>
          <p class="hs-app-n"><span class="hs-app-ic" data-appic style="--h:85">N</span><b data-appname>Notes</b></p>
          <i></i><i></i><i></i><i></i><i></i>
        </div>
      </div>
      <div class="hs-menu" data-menu role="group" aria-label="HandySwitcher: running programs">
        <ul class="hs-menu-list" data-list>
          {PROGS.map((p, i) => (
            <li data-p={p.id} class:list={{ act: i === 0 }}>
              <button type="button" class="hs-m-go" data-go={p.id}><span class="hs-m-ic" style={`--h:${p.hue}`}>{p.glyph}</span><span class="hs-m-n">{p.name}</span></button>
              <button type="button" class="hs-m-x" data-x={p.id} aria-label={`Close ${p.name}`} style={sprite(0, 6, actions.src)}></button>
            </li>
          ))}
        </ul>
        <ul class="hs-menu-acts">
          {ACTS.map(x => <li><button type="button" class="hs-m-go" data-act={x.a}><span class="hs-m-ic img" style={sprite(x.icon, 6, actions.src)}></span><span class="hs-m-n">{x.label}</span></button></li>)}
        </ul>
        <p class="hs-menu-foot"><span>HandySwitcher</span><span class="hs-opt">Opt</span></p>
      </div>
      <div class="hs-live-box" data-box hidden>
        <b>Warning...</b>
        <p><span data-boxname>Bubble Breaker</span> is not responding because it is busy, waiting for a response from you, or has stopped running.</p>
        <p>Do you want HandySwitcher to terminate the program anyway?</p>
        <button type="button" data-yes>Yes</button><button type="button" data-no>No</button>
      </div>
      <p class="hs-live-st" aria-live="polite" data-st></p>
    </div>
    <Fragment slot="status"><span class="sk-l" data-sk>New</span><span class="sk-r" data-sk>Menu</span></Fragment>
  </Window>
  {!solo && <p class="hs-live-tip" data-tip hidden>Tap <b>its icon</b> in the top bar to open the menu. Tap a name to switch to it, or its <b>X</b> to close it.</p>}
</div>

<style is:global>
  .hs-live-wrap { display: grid; justify-items: center; gap: 12px; }
  .hs-live { --mt: #ffffff; --mbk: #3f9f9f; --ibk: #2e8080; --ht: #ffffff; --hbk: #4f7fb8;
    position: relative; height: 100%; font: 400 11px/1.2 var(--wm-font); color: #000; background: #fff; overflow: hidden; }
  .hs-scr { position: absolute; inset: 0; }
  .hs-today { height: 100%; }
  .hs-today[hidden], .hs-app[hidden] { display: none; }
  /* A program in front: its page, drawn as Windows Mobile draws an empty document list */
  .hs-app { display: grid; align-content: start; gap: 9px; height: 100%; padding: 0 0 0; background: #fff; }
  .hs-app-n { display: flex; align-items: center; gap: 5px; margin: 0; padding: 4px 3px 3px; font-weight: 700; color: var(--wm-head); border-bottom: 1px solid var(--wm-head); }
  .hs-app i { height: 6px; margin: 0 6px; background: #e3e7ea; }
  .hs-app i:nth-of-type(2n) { margin-right: 60px; }
  .hs-app-ic, .hs-m-ic { display: grid; place-items: center; flex: none; width: 16px; height: 16px; font: 700 9px/1 var(--wm-font); color: #fff; background: oklch(0.6 0.15 var(--h, 250)); border: 1px solid oklch(0.38 0.1 var(--h, 250)); border-radius: 2px; }
  /* His menu, owner-drawn under the title bar: bold names, his red X on each, the actions, then his name and Opt */
  .hs-menu { position: absolute; top: 0; right: 5px; width: 172px; color: var(--mt); background: var(--mbk); border: 1px solid #000; transform-origin: 70% 0; font-weight: 700; }
  .hs-live.is-live:not(.open) .hs-menu { display: none; }
  .hs-menu ul { margin: 0; padding: 0; list-style: none; }
  .hs-menu li { display: flex; align-items: stretch; height: 20px; }
  .hs-menu-list { background: linear-gradient(90deg, var(--ibk) 0 21px, transparent 21px); }
  .hs-menu-acts { margin-top: 5px !important; padding-top: 4px !important; background: linear-gradient(var(--mt), var(--mt)) 7px 0 / calc(100% - 14px) 1px no-repeat, linear-gradient(90deg, var(--ibk) 0 21px, transparent 21px); }
  .hs-m-go { flex: 1; display: flex; align-items: center; gap: 5px; min-width: 0; padding: 0 2px; font: inherit; color: inherit; text-align: left; background: none; border: 0; cursor: pointer; }
  .hs-m-ic.img { border: 0; border-radius: 0; background-color: transparent; background-repeat: no-repeat; image-rendering: pixelated; }
  .hs-m-n { overflow: hidden; text-overflow: clip; white-space: nowrap; }
  .hs-m-go:hover, .hs-m-go:focus-visible { color: var(--ht); background: var(--hbk); outline: none; }
  .hs-m-x { flex: none; width: 24px; padding: 2px 4px; border: 0; background-repeat: no-repeat; background-color: transparent; background-origin: content-box; background-clip: content-box; cursor: pointer; image-rendering: pixelated; background-size: 96px 16px !important; background-position: 0 0 !important; }
  .hs-m-x:hover, .hs-m-x:focus-visible { outline: 1px solid var(--ht); outline-offset: -2px; }
  .hs-menu li.closing { opacity: 0.5; }
  .hs-menu-foot { display: flex; justify-content: space-between; align-items: center; height: 16px; margin: 3px 0 0 !important; padding: 0 2px 0 3px; color: #000; background: linear-gradient(#fff, #dcdcdc); border-top: 1px solid #000; font: 700 11px/1 var(--wm-font) !important; }
  .hs-opt { padding: 0 2px; line-height: 11px; border: 1px solid #000; border-radius: 4px; }
  .hs-live-st { pointer-events: none; position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: 3px 4px; font-size: 11px !important; line-height: 1.25 !important; color: #000; background: #ffffe1; border-top: 1px solid #000; }
  .hs-live-st:empty { display: none; }
  /* The Windows Mobile message box he raises for a program that does not answer */
  .hs-live-box { position: absolute; left: 0; right: 0; top: 0; z-index: 3; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 8px; padding: 0 8px 8px; background: #fff; border-bottom: 1px solid #000; font-size: 11px !important; }
  .hs-live-box[hidden] { display: none; }
  .hs-live-box b { grid-column: 1 / -1; margin: 0 -8px; padding: 4px 3px 3px; color: var(--wm-head); border-bottom: 1px solid var(--wm-head); }
  .hs-live-box p { grid-column: 1 / -1; margin: 0; }
  .hs-live-box button { height: 21px; font: inherit; color: #000; background: #fff; border: 1px solid #000; cursor: pointer; }
  .hs-live-box button:active { color: #fff; background: #000; }
  .hs-live-box button:focus-visible { outline: 1px dotted #000; outline-offset: -4px; }
  .hs-live-tip { max-width: 34ch; margin: 0 !important; text-align: center; font-size: 0.9375rem !important; color: var(--ink-2); }
  /* His icon sits on the title bar at a fixed place, over the title, as in DinarSoft's own screenshots */
  .hs-live-dev > .win-bar .hs-bar-ic { position: absolute; left: 63px; top: 4px; width: 18px; height: 18px; padding: 1px; background: var(--bar) no-repeat; background-size: 400% 100%; background-origin: content-box; background-clip: content-box; border: 0; cursor: pointer; image-rendering: pixelated; }
  .hs-live-dev > .win-bar .hs-bar-ic[aria-expanded='true'] { background-color: oklch(1 0 0 / 0.3); }
  .hs-live-dev > .win-bar .hs-bar-ic::after { content: ''; position: absolute; inset: -4px -6px; }
  .hs-live-dev > .win-bar :is(.hs-bar-ic, .hs-bar-x):focus-visible { outline: 2px solid #fff; outline-offset: 0; }
  .hs-live-dev > .win-bar .hs-bar-x { padding: 0; cursor: pointer; }
</style>

<script>
  import { gsap } from 'gsap';
  import { PROGS, reduce, type Prog } from './hs.ts';

  document.querySelectorAll<HTMLElement & { hs?: boolean }>('[data-hslive]').forEach(root => {
    if (root.hs) return;
    root.hs = true;
    const win = root.closest<HTMLElement>('.win')!, barEl = win.querySelector<HTMLElement>('.win-bar')!, title = win.querySelector<HTMLElement>('.win-title')!;
    const menu = root.querySelector<HTMLElement>('[data-menu]')!, list = root.querySelector<HTMLElement>('[data-list]')!;
    const st = root.querySelector<HTMLElement>('[data-st]')!, box = root.querySelector<HTMLElement>('[data-box]')!;
    const today = root.querySelector<HTMLElement>('[data-today]')!, view = root.querySelector<HTMLElement>('[data-appview]')!;
    const appIc = root.querySelector<HTMLElement>('[data-appic]')!, appName = root.querySelector<HTMLElement>('[data-appname]')!;
    const keys = [...win.querySelectorAll<HTMLElement>('[data-sk]')], ctl = win.querySelector<HTMLElement>('.win-ctl')!;
    let running: Prog[] = [...PROGS], active: Prog | null = PROGS[0], busy = false;

    // His icon and the (X) he takes over, inside the system bar
    const ic = document.createElement('button');
    ic.type = 'button'; ic.className = 'hs-bar-ic'; ic.setAttribute('aria-label', 'HandySwitcher'); ic.setAttribute('aria-expanded', 'false');
    const x = document.createElement('button');
    x.type = 'button'; x.className = 'hs-bar-x wm-x'; x.setAttribute('aria-label', 'Close the active program');
    barEl.insertBefore(ic, title.nextSibling);
    ctl.removeAttribute('aria-hidden');
    ctl.append(x);

    const say = (t: string) => { st.textContent = t; };
    const show = (p: Prog | null) => {
      active = p;
      today.hidden = !!p; view.hidden = !p;
      title.textContent = p ? p.name : 'Start';
      x.hidden = !p;
      (p ? ['New', 'Menu'] : ['Phone', 'Contacts']).forEach((t, i) => (keys[i].textContent = t));
      if (p) { appIc.textContent = p.glyph; appIc.style.setProperty('--h', String(p.hue)); appName.textContent = p.name; }
      list.querySelectorAll('li').forEach(li => li.classList.toggle('act', li.dataset.p === p?.id));
    };
    const open = (on: boolean) => {
      root.classList.toggle('open', on);
      ic.setAttribute('aria-expanded', String(on));
      if (on) {
        if (!reduce()) gsap.fromTo(menu, { scaleY: 0.2, opacity: 0 }, { scaleY: 1, opacity: 1, duration: 0.22, ease: 'power2.out' });
        menu.querySelector<HTMLElement>('button')?.focus();
      }
    };
    const remove = (p: Prog) => {
      running = running.filter(r => r !== p);
      const li = list.querySelector<HTMLElement>(`[data-p="${p.id}"]`);
      if (li) { if (reduce()) li.remove(); else gsap.to(li, { height: 0, minHeight: 0, opacity: 0, duration: 0.25, onComplete: () => li.remove() }); }
      if (active === p) show(running[0] ?? null);
    };
    const wait = (ms: number) => new Promise(r => setTimeout(r, reduce() ? 0 : ms));
    const ask = (p: Prog) => new Promise<boolean>(res => {
      root.querySelector('[data-boxname]')!.textContent = p.name;
      box.hidden = false;
      box.querySelector<HTMLElement>('[data-yes]')!.focus();
      const done = (v: boolean) => { box.hidden = true; res(v); };
      box.querySelector<HTMLElement>('[data-yes]')!.onclick = () => done(true);
      box.querySelector<HTMLElement>('[data-no]')!.onclick = () => done(false);
    });
    // The same order as his routine at 0x17D4C, sped up 4 times
    const close = async (p: Prog) => {
      list.querySelector(`[data-p="${p.id}"]`)?.classList.add('closing');
      show(p);
      if (p.kind === 'player') { say('Media Player: pressing its own Ctrl+Q'); await wait(300); }
      say(`Asking ${p.name} to close...`);
      await wait(250);
      if (p.kind === 'polite' || p.kind === 'player') { remove(p); say(`${p.name} closed.`); return; }
      if (p.kind === 'slow') { say(`${p.name} is saving. Waiting...`); await wait(700); remove(p); say(`${p.name} closed after 2.5 seconds.`); return; }
      say(`${p.name} is not answering. Waiting up to 6 seconds...`);
      await wait(1400);
      if (await ask(p)) { remove(p); say(`${p.name} ended. Its memory is free again.`); }
      else { list.querySelector(`[data-p="${p.id}"]`)?.classList.remove('closing'); say(`${p.name} is still running.`); }
    };
    const run = async (f: () => Promise<void>) => { if (busy) return; busy = true; try { await f(); } finally { busy = false; } };

    ic.addEventListener('click', () => open(!root.classList.contains('open')));
    x.addEventListener('click', () => run(async () => { if (active) await close(active); else say('Nothing to close: this is the Today screen.'); }));
    root.addEventListener('click', e => {
      const t = (e.target as Element).closest<HTMLElement>('button');
      if (!t || box.contains(t)) return;
      const p = PROGS.find(r => r.id === (t.dataset.go ?? t.dataset.x));
      if (t.dataset.go && p) { show(p); open(false); say(`Switched to ${p.name}.`); }
      else if (t.dataset.x && p) run(() => close(p));
      else if (t.dataset.act === 'min') { show(null); open(false); say('Every program minimized. They keep running.'); }
      else if (t.dataset.act === 'all') run(async () => { for (const r of [...running]) await close(r); });
      else if (t.dataset.act === 'others') run(async () => { const keep = active; for (const r of [...running]) if (r !== keep) await close(r); if (keep) show(keep); });
    });
    root.addEventListener('keydown', e => { if (e.key === 'Escape' && root.classList.contains('open')) { open(false); ic.focus(); } });
    root.classList.add('is-live');
    const tip = win.parentElement!.querySelector<HTMLElement>('[data-tip]');
    if (tip) tip.hidden = false;
    show(PROGS[0]);
  });
</script>
