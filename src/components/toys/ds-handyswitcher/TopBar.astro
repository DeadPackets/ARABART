---
// HHTask.exe (2.7): how HandySwitcher, HandyMenu and HandyLauncher get a seat on the system's own top bar.
// Tap a part of the bar, then step his code: his function sees the tap first and hands everything else back.
import CodeStepper from '../CodeStepper.astro';
import { hookSteps, type Zone } from './hs.ts';
import icons from './topbar-16.png';

const steps = hookSteps('switcher');
const ZONES: { z: Zone; label: string; icon?: number }[] = [
  { z: 'start', label: 'Start' },
  { z: 'switcher', label: 'HandySwitcher', icon: 0 },
  { z: 'menu', label: 'HandyMenu', icon: 2 },
  { z: 'launcher', label: 'HandyLauncher', icon: 1 },
  { z: 'close', label: 'Close (X)' },
];
const ASM = [
  { off: '11C98', code: 'ldr  r0,=HHTaskBar', note: 'the top bar’s class name' },
  { off: '11C9C', code: 'bl   FindWindowW', note: 'find the system’s top bar' },
  { off: '11CA4', code: 'ldr  r2,=12628h', note: 'his own function' },
  { off: '11CAC', code: 'mvn  r1,#3', note: '-4: its message handler' },
  { off: '11CB0', code: 'bl   SetWindowLongW', note: 'swap his in, get the old one back' },
  { off: '11CB8', code: 'str  r0,[r1]', note: 'keep the old one' },
  { off: '126B4', label: 'proc', code: 'cmp  fp,r3', note: 'a tap? (WM_LBUTTONDOWN)' },
  { off: '12748', code: 'bl   PtInRect', note: 'on the HandySwitcher icon?' },
  { off: '12778', code: 'bl   PostMessageW', note: 'tell that app' },
  { off: '127E4', code: 'bl   PtInRect', note: 'on the HandyMenu icon?' },
  { off: '12844', code: 'bl   PtInRect', note: 'on the HandyLauncher icon?' },
  { off: '12854', code: 'bl   SHRecognizeGesture', note: 'tap, or tap and hold?' },
  { off: '128A8', code: 'bl   PtInRect', note: 'on the (X) button?' },
  { off: '1294C', code: 'bl   CallWindowProcW', note: 'not his: pass it on' },
];
const C = [
  { code: 'HWND bar = FindWindow(L"HHTaskBar", 0);' },
  { code: 'old = SetWindowLong(bar, GWL_WNDPROC,' },
  { code: '                    BarProc);' },
  { code: 'LRESULT BarProc(w, m, wp, lp) {' },
  { code: '  if (m == WM_LBUTTONDOWN) {' },
  { code: '    if (PtInRect(&rcSwitcher, pt))' },
  { code: '      return Tell(switcher, MENU);' },
  { code: '    if (PtInRect(&rcMenu, pt))' },
  { code: '      return Tell(menu, Gesture());' },
  { code: '    if (PtInRect(&rcLaunch, pt))' },
  { code: '      return Tell(launch, Gesture());' },
  { code: '    if (PtInRect(&rcX, pt) && ownsX)' },
  { code: '      return Tell(switcher, Gesture());' },
  { code: '  }' },
  { code: '  return CallWindowProc(old,w,m,wp,lp);' },
  { code: '}' },
];
---

<div class="hs-tb" data-hstb>
  <CodeStepper id="hs-hook" title="HHTASK.EXE  a seat on the top bar" asm={ASM} c={C} steps={steps} speed={0.9}>
    <div slot="visual" class="hs-tb-vis" data-vis>
      <p class="hs-tb-ask" data-ask hidden>Tap a part of the top bar:</p>
      <div class="hs-tb-bar" role="group" aria-label="The Windows Mobile top bar">
        {ZONES.map(x => (
          <button type="button" class:list={['hs-tb-z', `z-${x.z}`, { on: x.z === 'switcher' }]} data-z={x.z} aria-pressed={String(x.z === 'switcher')} disabled>
            {x.icon != null ? <span class="hs-tb-ic" style={`background-image:url(${icons.src});background-position:${x.icon * 100 / 3}% 0`} /> : null}
            {x.z === 'start' && <span class="hs-tb-flag" aria-hidden="true" />}
            <span class={x.icon != null ? 'sr' : ''}>{x.z === 'start' ? 'Today' : x.label}</span>
          </button>
        ))}
      </div>
      <ol class="hs-tb-flow" aria-label="Where the tap goes">
        <li data-node="tap">Your tap</li>
        <li data-node="his" class="on">His function</li>
        <li class="hs-tb-to">
          <span data-node="HandySwitcher" class="on">HandySwitcher</span>
          <span data-node="HandyMenu">HandyMenu</span>
          <span data-node="HandyLauncher">HandyLauncher</span>
          <span data-node="system">Old function: the system</span>
        </li>
      </ol>
    </div>
  </CodeStepper>
</div>

<style is:global>
  .hs-tb-vis { display: grid; gap: 14px; padding: 14px; background: #fff; box-shadow: inset 0 0 0 1px var(--rule); }
  .hs-tb-ask { margin: 0 !important; font: 600 0.9375rem/1.3 var(--sans) !important; }
  .hs-tb-bar { display: flex; align-items: stretch; height: 48px; padding: 0 4px; background: linear-gradient(oklch(0.48 0.15 258), oklch(0.32 0.14 262)); border-radius: 4px; }
  .hs-tb-z { display: flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; padding: 0 10px; font: 600 0.9375rem/1 Tahoma, Verdana, sans-serif; color: #fff; background: none; border: 0; border-radius: 3px; cursor: pointer; }
  .hs-tb-z:disabled { cursor: default; }
  .hs-tb-z.z-start { flex: 1; justify-content: flex-start; }
  .hs-tb-z.z-close { margin-left: 6px; padding: 0 12px; font-weight: 700; }
  .hs-tb-z.on { background: oklch(1 0 0 / 0.22); box-shadow: inset 0 0 0 2px oklch(0.85 0.14 85); }
  .hs-tb-z:not(:disabled):hover { background: oklch(1 0 0 / 0.14); }
  .hs-tb-z:focus-visible { outline: 2px solid oklch(0.85 0.14 85); outline-offset: -2px; }
  .hs-tb-ic { width: 24px; height: 24px; background-size: 400% 100%; image-rendering: pixelated; }
  .hs-tb-flag { width: 18px; height: 18px; flex: none; background: conic-gradient(from 90deg, oklch(0.65 0.2 145) 25%, oklch(0.75 0.17 85) 0 50%, oklch(0.62 0.19 255) 0 75%, oklch(0.62 0.22 28) 0); border-radius: 2px; transform: skewY(-6deg); }
  .hs-tb-z .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .hs-tb-flow { display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: center; gap: 10px 28px; margin: 0 !important; padding: 0 !important; list-style: none; }
  .hs-tb-flow > li { position: relative; margin: 0 !important; font: 600 0.875rem/1.2 var(--sans) !important; }
  .hs-tb-flow > li:not(.hs-tb-to)::after { content: '→'; position: absolute; right: -21px; top: 50%; translate: 0 -50%; color: var(--ink-2); }
  .hs-tb-flow [data-node] { display: block; padding: 8px 10px; background: var(--surface); border: 1px solid var(--rule); border-radius: 3px; transition: background 0.2s, color 0.2s; }
  .hs-tb-to { display: grid; gap: 6px; }
  .hs-tb-flow [data-node].on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .hs-tb-flow [data-node].off { opacity: 0.72; border-style: dashed; }
  @media (max-width: 640px) {
    .hs-tb-bar { height: 44px; }
    .hs-tb-z { padding: 0 6px; font-size: 0.8125rem; }
    .hs-tb-flow { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .hs-tb-flow > li:not(.hs-tb-to)::after { content: '↓'; right: auto; left: 12px; top: auto; bottom: -17px; translate: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { hookSteps, reduce, type HookStep, type Zone } from './hs.ts';

  document.querySelectorAll<HTMLElement & { hs?: boolean }>('[data-hstb]').forEach(root => {
    if (root.hs) return;
    root.hs = true;
    const cs = root.querySelector<HTMLElement & { stepper?: { load(s: unknown[], at?: number): void } }>('[data-stepper]')!;
    const zones = [...root.querySelectorAll<HTMLButtonElement>('[data-z]')];
    const node = (n: string) => root.querySelector<HTMLElement>(`[data-node="${n}"]`)!;
    cs.addEventListener('stepper', e => {
      const { step: s, how } = (e as CustomEvent).detail as { step: HookStep; how: string };
      zones.forEach(z => z.classList.toggle('on', z.dataset.z === s.zone));
      node('tap').classList.toggle('on', !!s.zone);
      node('his').classList.toggle('on', s.hooked);
      for (const n of ['HandySwitcher', 'HandyMenu', 'HandyLauncher', 'system']) {
        node(n).classList.toggle('on', s.to === n);
        node(n).classList.toggle('off', !!s.to && s.to !== n);
      }
      if (s.to && !reduce() && how !== 'jump' && how !== 'scrub') gsap.fromTo(node(s.to), { x: -12 }, { x: 0, duration: 0.4, ease: 'back.out(2)' });
    });
    zones.forEach(z => {
      z.disabled = false;
      z.addEventListener('click', () => {
        zones.forEach(o => o.setAttribute('aria-pressed', String(o === z)));
        cs.stepper?.load(hookSteps(z.dataset.z as Zone), 3);
      });
    });
    root.querySelector<HTMLElement>('[data-ask]')!.hidden = false;
  });
</script>
