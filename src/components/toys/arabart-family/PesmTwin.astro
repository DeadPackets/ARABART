---
// PESM.EXE (1991) beside ARABART.EXE (1993): pick a block they share and compare it byte by byte, live, from the two
// real files. Point at a byte and its twin lights up.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Window from '../../shell/Window.astro';
import { TWINS } from './pesm.ts';
import { hex } from '../arabart/core.ts';

interface Props { id?: string }
const { id = 'pesmtwin' } = Astro.props;
const base = import.meta.env.BASE_URL;
const read = (f: string) => new Uint8Array(readFileSync(join(process.cwd(), 'public/bytes/files', f)));
const P = read('PESM_PESM.EXE.mem'), A = read('ARABART_ARABART.EXE.mem');
const H = 0x30; // both unpacked files carry a 30h-byte header before the image
const t0 = TWINS[0];
const rows = (bytes: Uint8Array, at: number, n: number) => Array.from({ length: Math.ceil(n / 8) }, (_, r) => ({ off: hex(at + r * 8, 4), b: [...bytes.subarray(H + at + r * 8, H + at + Math.min(n, r * 8 + 8))].map(x => hex(x)) }));
const pc = (n: number) => +((n / (A.length - H)) * 100).toFixed(3), pct = (n: number, of: number) => +((n / of) * 100).toFixed(3);
---

<div class="pesmt" id={id} data-pesmtwin data-p={`${base}/bytes/files/PESM_PESM.EXE.mem`} data-a={`${base}/bytes/files/ARABART_ARABART.EXE.mem`} data-twins={JSON.stringify(TWINS)}>
  <div class="pesmt-tabs" role="radiogroup" aria-label="Which shared block">
    {TWINS.map((t, i) => <button type="button" role="radio" class="button k-btn" data-t={i} aria-checked={String(i === 0)} tabindex={i === 0 ? 0 : -1}>{t.name} <span class="hk">{t.n.toLocaleString('en-US')} B</span></button>)}
  </div>
  <Window title="TWO FILES, to the same scale" kind="panel" class="pesmt-map-win">
    <div class="pesmt-map" role="img" aria-label="PESM.EXE, 6,096 bytes, beside ARABART.EXE, 30,096 bytes, drawn to the same scale. Lines join the blocks they share.">
      <span class="pesmt-lab">PESM.EXE, 1991: {(P.length - H).toLocaleString('en-US')} bytes</span>
      <div class="pesmt-bar" style={`width:${pc(P.length - H)}%`}>
        {TWINS.map((t, i) => <i data-m={i} class:list={{ on: i === 0 }} style={`left:${pct(t.pesm, P.length - H)}%;width:${pct(t.n, P.length - H)}%`} />)}
      </div>
      <svg class="pesmt-wires" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
        {TWINS.map((t, i) => <path data-m={i} class:list={{ on: i === 0 }} d={`M${pc(t.pesm + t.n / 2)} 0 L${pc(t.arabart + t.n / 2)} 10`} />)}
      </svg>
      <span class="pesmt-lab">ARABART.EXE 4.15, 1993: {(A.length - H).toLocaleString('en-US')} bytes</span>
      <div class="pesmt-bar">
        {TWINS.map((t, i) => <i data-m={i} class:list={{ on: i === 0 }} style={`left:${pc(t.arabart)}%;width:${pc(t.n)}%`} />)}
      </div>
    </div>
  </Window>
  <div class="pesmt-dumps">
    <Window title={`PESM.EXE  ${hex(t0.pesm, 4)}h`} kind="editor" class="pesmt-d" data-side="p">
      <div class="pesmt-hex" data-hex tabindex="0" role="region" aria-label="PESM.EXE bytes">
        {rows(P, t0.pesm, t0.n).map((r, i) => <div class="pesmt-r"><span class="o">{r.off}</span>{r.b.map((b, j) => <i data-i={i * 8 + j}>{b}</i>)}</div>)}
      </div>
    </Window>
    <Window title={`ARABART.EXE  ${hex(t0.arabart, 4)}h`} kind="editor" class="pesmt-d" data-side="a">
      <div class="pesmt-hex" data-hex tabindex="0" role="region" aria-label="ARABART.EXE bytes">
        {rows(A, t0.arabart, t0.n).map((r, i) => <div class="pesmt-r"><span class="o">{r.off}</span>{r.b.map((b, j) => <i data-i={i * 8 + j}>{b}</i>)}</div>)}
      </div>
    </Window>
  </div>
  <div class="pesmt-run">
    <button type="button" class="button button--primary k-btn" data-compare>Compare byte by byte</button>
    <span class="pesmt-res" aria-live="polite" data-res>Two programs, two years apart. Compare them.</span>
  </div>
</div>

<style is:global>
  .pesmt { display: grid; gap: 18px; min-width: 0; }
  .pesmt-tabs { display: flex; flex-wrap: wrap; gap: 10px; }
  .pesmt-tabs .k-btn { padding: 0 12px; }
  .pesmt:not(.is-live) .pesmt-tabs, .pesmt:not(.is-live) .pesmt-run { display: none; }
  .pesmt-map { display: grid; gap: 6px; }
  .pesmt-lab { font: 500 13px/1.4 var(--font-code); color: var(--ink); }
  .pesmt-bar { position: relative; height: 26px; background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--accent-2); }
  .pesmt-bar i { position: absolute; top: 0; bottom: 0; min-width: 3px; background: var(--ink-2); opacity: 0.6; transition: background-color 0.25s, opacity 0.25s; }
  .pesmt-bar i.on { background: var(--accent); opacity: 1; }
  .pesmt-wires { display: block; width: 100%; height: 34px; margin: -6px 0; }
  .pesmt-wires path { fill: none; stroke: var(--ink-2); stroke-width: 1; opacity: 0.5; vector-effect: non-scaling-stroke; }
  .pesmt-wires path.on { stroke: var(--accent); stroke-width: 2; opacity: 1; }
  .pesmt-dumps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .pesmt-hex { max-height: 330px; overflow: auto; overscroll-behavior: contain; font: 500 13px/1.75 var(--font-code); }
  .pesmt-hex:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .pesmt-r { display: flex; gap: 0.6ch; white-space: nowrap; }
  .pesmt-r .o { min-width: 5ch; color: var(--accent-2); }
  .pesmt-r i { font-style: normal; color: var(--ink); padding: 0 1px; transition: background-color 0.2s; }
  .pesmt-r i.same { color: var(--surface); background: var(--accent-2); }
  .pesmt-r i.pair { color: var(--surface); background: var(--accent); }
  .pesmt-run { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .pesmt-res { font: 500 1rem/1.5 var(--sans); color: var(--ink); }
  .pesmt-res b { color: var(--accent); }
  @media (max-width: 760px) { .pesmt-dumps { grid-template-columns: minmax(0, 1fr); } .pesmt-hex { max-height: 220px; } }
  @media (prefers-reduced-motion: reduce) { .pesmt-r i, .pesmt-bar i { transition: none; } }
</style>

<script>
  import { gsap } from 'gsap';
  import { hex } from '../arabart/core.ts';
  import { reduce } from './vga.ts';

  type Twin = { name: string; pesm: number; arabart: number; n: number };
  document.querySelectorAll<HTMLElement>('[data-pesmtwin]').forEach(async root => {
    const get = async (u: string) => new Uint8Array(await (await fetch(u)).arrayBuffer());
    const [P, A] = await Promise.all([get(root.dataset.p!), get(root.dataset.a!)]);
    const twins: Twin[] = JSON.parse(root.dataset.twins!), H = 0x30;
    const panes = [...root.querySelectorAll<HTMLElement>('[data-side]')], res = root.querySelector<HTMLElement>('[data-res]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-t]')], marks = [...root.querySelectorAll<Element>('[data-m]')];
    let cur = 0, anim: gsap.core.Timeline | null = null;

    const fill = (t: Twin) => {
      panes.forEach(p => {
        const [bytes, at, name] = p.dataset.side === 'p' ? [P, t.pesm, 'PESM.EXE'] : [A, t.arabart, 'ARABART.EXE'];
        p.querySelector('.win-title')!.textContent = `${name}  ${hex(at, 4)}h`;
        let html = '';
        for (let r = 0; r < Math.ceil(t.n / 8); r++) {
          html += `<div class="pesmt-r"><span class="o">${hex(at + r * 8, 4)}</span>`;
          for (let j = r * 8; j < Math.min(t.n, r * 8 + 8); j++) html += `<i data-i="${j}">${hex(bytes[H + at + j])}</i>`;
          html += '</div>';
        }
        const box = p.querySelector<HTMLElement>('[data-hex]')!;
        box.innerHTML = html;
        box.scrollTop = 0;
      });
    };
    const pick = (i: number) => {
      cur = i; anim?.kill();
      tabs.forEach((b, j) => { b.setAttribute('aria-checked', String(j === i)); b.tabIndex = j === i ? 0 : -1; });
      marks.forEach(m => m.classList.toggle('on', +m.getAttribute('data-m')! === i));
      fill(twins[i]);
      res.textContent = `${twins[i].name}: ${twins[i].n.toLocaleString('en-US')} bytes in each file. Compare them.`;
    };
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => pick(i));
      b.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const j = (i + d + tabs.length) % tabs.length; pick(j); tabs[j].focus();
      });
    });

    root.querySelector('[data-compare]')!.addEventListener('click', () => {
      const t = twins[cur];
      let same = 0;
      for (let j = 0; j < t.n; j++) if (P[H + t.pesm + j] === A[H + t.arabart + j]) same++;
      const cells = panes.map(p => [...p.querySelectorAll<HTMLElement>('i[data-i]')]);
      const boxes = panes.map(p => p.querySelector<HTMLElement>('[data-hex]')!);
      const done = () => (res.innerHTML = `<b>${same.toLocaleString('en-US')} of ${t.n.toLocaleString('en-US')}</b> bytes are the same. Written in 1991, and not one byte needed changing for ARABART 4.15.`);
      anim?.kill();
      cells.flat().forEach(c => c.classList.remove('same'));
      if (reduce()) { cells.flat().forEach(c => c.classList.add('same')); done(); return; }
      const o = { k: 0 }, rowH = cells[0][0].offsetHeight || 22;
      let lit = 0;
      anim = gsap.timeline({ onComplete: done }).to(o, {
        k: t.n, duration: Math.min(2.4, 0.6 + t.n / 600), ease: 'none',
        onUpdate: () => {
          const k = Math.round(o.k);
          for (const list of cells) for (let j = lit; j < k; j++) list[j].classList.add('same');
          lit = k;
          boxes.forEach(b => (b.scrollTop = Math.max(0, (k / 8) * rowH - b.clientHeight / 2)));
          res.textContent = `Comparing… ${k.toLocaleString('en-US')} bytes`;
        },
      });
    });

    // Point at a byte: its twin lights up in the other file
    const unpair = () => panes.forEach(p => p.querySelectorAll('i.pair').forEach(c => c.classList.remove('pair')));
    root.addEventListener('pointerover', e => {
      const c = (e.target as Element).closest<HTMLElement>('i[data-i]');
      unpair();
      if (c) panes.forEach(p => p.querySelector(`i[data-i="${c.dataset.i}"]`)?.classList.add('pair'));
    });
    root.addEventListener('pointerleave', unpair);
    root.classList.add('is-live');
    pick(0);
  });
</script>
