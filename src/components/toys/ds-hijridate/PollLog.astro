---
// Every two seconds the Today screen asks each plug-in "do you need to redraw?" (WM_TODAYCUSTOM_QUERYREFRESHCACHE). HijriDate
// says yes only when the day, month or year it drew is no longer today's (sub_103ebc). Drag the clock across midnight.
import { toHijri, HIJRI_EN } from './hijri.ts';
interface Props { id: string }
const { id } = Astro.props;
const a = toHijri(2006, 9, 23, 1), b = toHijri(2006, 9, 24, 1);
const name = (r: { hd: number; hm: number; hy: number }) => `${r.hd} ${HIJRI_EN[r.hm - 1]} ${r.hy}`;
---

<div class="hdt-pl" id={id} data-pl data-a={name(a)} data-b={name(b)}>
  <label class="hdt-pl-ctl"><span>Clock on the device</span>
    <input type="range" min="0" max="10" step="1" value="10" data-t aria-valuetext="00:00:10" />
    <output data-clock>00:00:10</output>
  </label>
  <div class="hdt-pl-grid">
    <ol class="hdt-pl-log" data-log aria-label="The Today screen’s questions and HijriDate’s answers">
      {Array.from({ length: 11 }, (_, i) => {
        const sec = 50 + i * 2, mid = sec >= 60, t = mid ? `00:00:${String(sec - 60).padStart(2, '0')}` : `23:59:${sec}`;
        return <li class:list={{ 'is-yes': sec === 60 }} data-i={i}><time>{t}</time> Redraw? <b>{sec === 60 ? 'Yes: the date changed' : 'No'}</b></li>;
      })}
    </ol>
    <div class="hdt-pl-line" data-line aria-live="polite">{name(b)}</div>
  </div>
</div>

<style>
  .hdt-pl { display: grid; gap: 14px; min-width: 0; }
  .hdt-pl-ctl { display: grid; grid-template-columns: auto minmax(140px, 1fr) auto; gap: 8px 14px; align-items: center; font-weight: 600; }
  .hdt-pl-ctl input { width: 100%; min-height: 44px; accent-color: var(--accent); }
  .hdt-pl-ctl output { font: 700 1.1rem var(--font-code); }
  .hdt-pl-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .hdt-pl-log { margin: 0; padding: 10px 12px; list-style: none; max-height: 260px; overflow: auto; font: 500 0.875rem/1.7 var(--font-code); background: var(--surface-2, transparent); border: 1px solid var(--rule); }
  .hdt-pl-log li[hidden] { display: none; }
  .hdt-pl-log time { color: var(--ink-2); margin-right: 1ch; }
  .hdt-pl-log .is-yes b { color: var(--accent); }
  .hdt-pl-line { padding: 18px; background: linear-gradient(170deg, #4d9be8, #1f5fb8); color: #fff; font: 700 1.25rem/1.3 Tahoma, Verdana, sans-serif; text-align: right; }
  @media (max-width: 640px) { .hdt-pl-grid, .hdt-pl-ctl { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-pl]')) {
    const t = root.querySelector<HTMLInputElement>('[data-t]')!, clock = root.querySelector('[data-clock]')!, line = root.querySelector('[data-line]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-log] li')], log = root.querySelector<HTMLElement>('[data-log]')!;
    const set = () => {
      const i = +t.value, sec = 50 + i * 2, text = sec >= 60 ? `00:00:${String(sec - 60).padStart(2, '0')}` : `23:59:${sec}`;
      clock.textContent = text; t.setAttribute('aria-valuetext', text);
      rows.forEach((r, k) => (r.hidden = k > i));
      line.textContent = sec >= 60 ? root.dataset.b! : root.dataset.a!;
      log.scrollTop = log.scrollHeight;
    };
    t.addEventListener('input', set);
    t.value = '0'; set();
  }
</script>
