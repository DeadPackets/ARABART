---
// HijriDate's trial record, \Windows\inter.dat: 14 bytes written by the installer (sub_1059e4) and checked on every
// start (sub_105b60): the install date twice, in two disguises, every odd byte nudged by one, and a checksum.
// Tap a byte to change it and watch the check catch it.
import { WORDS, encode } from './trial.ts';
interface Props { id: string }
const { id } = Astro.props;
const bytes = encode(2006, 9, 24);
const html = WORDS.map((t, k) => `<div class="hdt-tf-w"><span>${t}</span>` + [0, 1].map(h => { const n = k * 2 + h; return `<button type="button" data-b="${n}" class="${n % 2 ? 'is-odd' : ''}" aria-label="Byte ${n}: ${bytes[n]}">${bytes[n].toString(16).toUpperCase().padStart(2, '0')}</button>`; }).join('') + `<b>✓ ${k < 6 ? '' : 'sum'}</b></div>`).join('');
---

<div class="hdt-tf" id={id} data-tf>
  <div class="hdt-tf-in">
    <label><span>Installed on</span><input type="date" value="2006-09-24" data-inst /></label>
    <label><span>Today on the device</span><input type="date" value="2006-09-27" data-now /></label>
    <button type="button" class="button k-btn" data-reset>Undo my changes</button>
  </div>
  <div class="hdt-tf-bytes" data-bytes role="group" aria-label="The 14 bytes of inter.dat. Each button adds one to its byte." set:html={html} />
  <p class="hdt-tf-say" aria-live="polite" data-say>Installed 24 September 2006, so on 27 September the trial has 12 days left.</p>
</div>

<style>
  .hdt-tf { display: grid; gap: 16px; min-width: 0; }
  .hdt-tf-in { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: end; }
  .hdt-tf-in label { display: grid; gap: 6px; font-weight: 600; }
  .hdt-tf-in input { min-height: 44px; padding: 0 10px; font: inherit; border: 1px solid var(--rule); background: var(--surface); color: var(--ink); }
  .hdt-tf-bytes { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
  .hdt-tf-bytes :global(.hdt-tf-w) { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; align-content: start; }
  .hdt-tf-bytes :global(.hdt-tf-w > span) { grid-column: 1 / -1; font-size: 0.75rem; line-height: 1.3; color: var(--ink-2); min-height: 2.6em; }
  .hdt-tf-bytes :global(button) { min-height: 44px; padding: 0; border: 1px solid var(--rule); background: var(--surface); color: var(--ink); font: 700 0.9375rem var(--font-code); cursor: pointer; }
  .hdt-tf-bytes :global(button.is-odd) { box-shadow: inset 0 -3px 0 var(--accent-2); }
  .hdt-tf-bytes :global(button.is-changed) { background: var(--accent); color: var(--black); }
  .hdt-tf-bytes :global(.hdt-tf-w b) { grid-column: 1 / -1; font: 700 0.875rem var(--font-code); }
  .hdt-tf-bytes :global(.is-bad b) { color: var(--hot); }
  .hdt-tf-say { margin: 0; font-weight: 600; }
  @media (max-width: 760px) { .hdt-tf-bytes { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 420px) { .hdt-tf-bytes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<script>
  import { WORDS, encode, decode, dayNo } from './trial.ts';
  const name = (y: number, m: number, d: number) => new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

  for (const root of document.querySelectorAll<HTMLElement>('[data-tf]')) {
    const inst = root.querySelector<HTMLInputElement>('[data-inst]')!, now = root.querySelector<HTMLInputElement>('[data-now]')!;
    const box = root.querySelector<HTMLElement>('[data-bytes]')!, say = root.querySelector('[data-say]')!;
    let clean: number[] = [], bytes: number[] = [];
    const render = () => {
      const r = decode(bytes), bad = [!r.ok.month, !r.ok.year, !r.ok.year, !r.ok.day, !r.ok.month, !r.ok.day, !r.ok.sum];
      box.innerHTML = WORDS.map((w, k) =>
        `<div class="hdt-tf-w${bad[k] ? ' is-bad' : ''}"><span>${w}</span>` +
        [0, 1].map(h => { const n = k * 2 + h; return `<button type="button" data-b="${n}" class="${n % 2 ? 'is-odd' : ''}${bytes[n] !== clean[n] ? ' is-changed' : ''}" aria-label="Byte ${n}: ${bytes[n]}">${bytes[n].toString(16).toUpperCase().padStart(2, '0')}</button>`; }).join('') +
        `<b>${bad[k] ? '✗' : '✓'} ${k < 6 ? '' : 'sum'}</b></div>`).join('');
      const [ny, nm, nd] = now.value.split('-').map(Number);
      if (!r.good) {
        const why = !r.ok.sum ? 'the checksum no longer matches' : !r.ok.year ? 'the two copies of the year disagree' : !r.ok.month ? 'the two copies of the month disagree' : 'the two copies of the day disagree';
        say.textContent = `Caught: ${why}. HijriDate treats the record as broken, and the trial is over.`;
        return;
      }
      const left = dayNo(r.y, r.m, r.d) + 15 - dayNo(ny, nm, nd);
      say.textContent = left > 15 ? `The device clock is earlier than the install date, ${name(r.y, r.m, r.d)}: the trial is over.`
        : left < 0 ? `Installed ${name(r.y, r.m, r.d)}: the 15 days are up. Time to register.`
        : `Installed ${name(r.y, r.m, r.d)}, so on ${name(ny, nm, nd)} the trial has ${left} day${left === 1 ? '' : 's'} left.`;
    };
    const reset = () => { const [y, m, d] = inst.value.split('-').map(Number); clean = encode(y, m, d); bytes = [...clean]; render(); };
    box.addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-b]'); if (!b) return;
      const n = +b.dataset.b!; bytes[n] = (bytes[n] + 1) & 255; render();
      box.querySelector<HTMLElement>(`[data-b="${n}"]`)?.focus();
    });
    inst.addEventListener('change', reset); now.addEventListener('change', render);
    root.querySelector('[data-reset]')!.addEventListener('click', reset);
    reset();
  }
</script>
