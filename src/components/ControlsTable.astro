---
import type { ProgramControl } from '../data/programs';

interface Props {
  controls: ProgramControl[];
}

const { controls } = Astro.props;
// "SHIFT + Q,W,E,R" -> [["Shift"], ["Q", "W", "E", "R"]]
const keys = (combo: string) =>
  combo.split('+').map(part => part.split(',').map(k => k.trim().replace(/^SHIFT$/, 'Shift').replace(/-/g, '–')));
---

{controls.length > 0 && (
  <dl class="controls">
    {controls.map(ctrl => (
      <div class="row">
        <dt>{keys(ctrl.key).map((group, i) => <>{i > 0 && <span class="plus">+</span>}{group.map(k => <kbd>{k}</kbd>)}</>)}</dt>
        <dd>{ctrl.action}</dd>
      </div>
    ))}
  </dl>
)}

<style>
  .controls { display: grid; gap: 16px; }
  .row { display: grid; gap: 8px; }
  dt { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .plus { font-size: 0.875rem; color: var(--cyan); }
  dd { font-size: 0.9375rem; color: var(--ink-2); }
</style>
