---
import BaseLayout from '../layouts/BaseLayout.astro';
import DosPlayer from '../components/DosPlayer.astro';
import Commander from '../components/Commander.astro';
import { bundleSize } from '../data/files';

const base = import.meta.env.BASE_URL;
const bundleUrl = `${base}/bundles/terminal.jsdos?v=${Date.now()}`;
---

<BaseLayout
  title="DOS shell · Yasser Awad"
  description="Boot the whole archive as one DOS machine and browse Yasser Awad's programs from a real command line."
  hasEmulator={true}
>
  <div class="container">
    <header class="head">
      <h1>DOS shell</h1>
      <p class="lead">His whole archive as one DOS machine. Click the screen and type, or let the buttons type for you.</p>
    </header>

    <div class="grid">
      <section aria-label="DOS shell emulator">
        <DosPlayer
          bundleUrl={bundleUrl}
          name="the archive"
          title={"C:\\"}
          image={`${base}/images/terminal.svg`}
          alt="A DOS prompt with a welcome message"
          bundleBytes={bundleSize('terminal')}
        />
      </section>
      <Commander />
    </div>
  </div>
</BaseLayout>

<style>
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; padding-block: 16px 20px; }
  .head h1 { font: 400 32px/1.2 var(--font-dos); color: var(--accent); }
  .head .lead { font-size: 1.0625rem; color: var(--ink-2); }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(300px, 26vw, 380px);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } }
</style>
