---
// The timeline became the home collection (programs are listed oldest first there)
const to = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/#programs`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <link rel="canonical" href={to} />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} />
  <title>Moved to the collection · Yasser Awad</title>
</head>
<body>
  <p>The timeline is now the <a href={to}>collection on the home page</a>.</p>
</body>
</html>
