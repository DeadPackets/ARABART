---
// One program: it runs first, in a DOS screen window; its label sits beside it; then the story and the writeup in a calm
// reading column; then Norton Commander's key bar to step to the previous or next one.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../layouts/Toc.astro';
import DosPlayer from '../../components/DosPlayer.astro';
import ControlsTable from '../../components/ControlsTable.astro';
import Writeup from '../../components/explain/Writeup.astro';
import BytesMap from '../../components/BytesMap.astro';
import { programs } from '../../data/programs';
import { exeSize, bundleSize, bytes } from '../../data/files';
import { glance, shelf } from '../../layouts/glance';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => programs.map(program => ({ params: { id: program.id }, props: { program } }));

const { program } = Astro.props as { program: (typeof programs)[number] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bundleUrl = `${base}/bundles/${program.id}.jsdos?v=${Date.now()}`;
const title = program.title.replace(' - ', ': ');
const path = `C:\\${program.folder}\\${program.executable}`;
// Programs that start at a DOS prompt and want a command typed: one tap types it on a phone
const LINES: Record<string, string> = { 'kvc-antivirus': 'KVC C:' };
const at = shelf.findIndex(p => p.id === program.id);
const prev = shelf[(at + shelf.length - 1) % shelf.length], next = shelf[(at + 1) % shelf.length];
const short = (p: (typeof shelf)[number]) => p.title.replace(' - ', ' ');
// only the program writeups, so a program page does not carry the CSS of the DinarSoft, career and other pages
const home = new URL(`${base}/`, Astro.site).href;
const KIND: Record<string, string> = { educational: 'EducationalApplication', tool: 'UtilitiesApplication', utility: 'UtilitiesApplication', library: 'DeveloperApplication', demo: 'MultimediaApplication', splash: 'MultimediaApplication' };
const sw = { '@type': 'SoftwareApplication', '@id': `${home}program/${program.id}/#app`, name: title, description: glance[program.id] ?? program.description,
  url: `${home}program/${program.id}/`, operatingSystem: 'MS-DOS', applicationCategory: KIND[program.category], dateCreated: String(program.year),
  image: new URL(`${base}/images/${program.image}`, Astro.site).href, author: program.id === 'kvc-antivirus' ? [{ '@id': `${home}#yasser` }, { '@type': 'Person', name: 'Ebrahim El-Etr' }] : { '@id': `${home}#yasser` }, isAccessibleForFree: true };
const writeups = import.meta.glob(['../../writeups/*.astro', '!../../writeups/{dinarsoft-*,arabart,career,patents,primer}.astro']);
---

<BaseLayout
  title={`${title} (${program.year}) · Yasser Awad`}
  description={glance[program.id] ?? program.description}
  image={`${base}/images/${program.image}`}
  hasEmulator={true}
  schema={[sw]}
  crumbs={[['Programs', '#programs'], [title, `program/${program.id}/`]]}
  keys={[{ k: '►', label: `Next: ${next.title.replace(' - ', ': ')}`, href: `${base}/program/${next.id}/` }]}
>
  <article class="program">
    <div class="container top">
      <header class="ph">
        <a class="crumb" href={`${base}/#programs`}>← All fifteen programs</a>
        <h1>{title}</h1>
        <p class="when">{program.year} · {path}</p>
      </header>

      <section class="run" aria-label={`${title}, running in DOS`}>
        <DosPlayer
          bundleUrl={bundleUrl}
          name={program.executable}
          title={path}
          image={`${base}/images/${program.image}`}
          alt={`${title} running in DOS`}
          bundleBytes={bundleSize(program.id)}
          controls={program.controls}
          line={LINES[program.id]}
        />
      </section>

      <p class="lead">{glance[program.id] ?? program.subtitle}</p>

      <aside class="side" aria-label="About this program">
        {program.launchNotes && <p class="notes">{program.launchNotes}</p>}
        {program.controls.length > 0 && (
          <section aria-labelledby="keys-h">
            <h2 id="keys-h">Keys</h2>
            <ControlsTable controls={program.controls} />
          </section>
        )}
        <dl class="facts">
          <div><dt>Year</dt><dd>{program.year}</dd></div>
          <div><dt>Size</dt><dd>{bytes(exeSize(program))} bytes</dd></div>
          <div class="wide"><dt>Written in</dt><dd>{program.language}</dd></div>
        </dl>
      </aside>
    </div>

    <div class="container body">
      <div class="read">
        <section class="story" id="story" aria-labelledby="story-h">
          <h2 id="story-h" data-toc>The story</h2>
          <p>{program.story}</p>
        </section>
        <Writeup id={program.id} mods={writeups} />
        <BytesMap id={program.id} />
      </div>
      <Toc />
    </div>

    <nav class="container nc-keys" aria-label="Previous and next program">
      <a href={`${base}/program/${prev.id}/`} rel="prev"><b aria-hidden="true">◄</b><span>Previous: {short(prev)}</span></a>
      <a href={`${base}/program/${next.id}/`} rel="next"><span>Next: {short(next)}</span><b aria-hidden="true">►</b></a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* Desktop: the program runs on the left at the largest size that fits the screen; its label sits on the right */
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 300px);
    grid-template-rows: auto auto 1fr;
    grid-template-areas: 'run ph' 'run lead' 'run side';
    gap: 0 clamp(32px, 3.5vw, 56px);
    padding-top: 16px;
  }
  .ph { grid-area: ph; }
  .run { grid-area: run; min-width: 0; }
  .lead { grid-area: lead; margin-top: 14px; font-size: 1.125rem; line-height: 1.55; }
  .side { grid-area: side; display: grid; align-content: start; gap: 28px; margin-top: 28px; }

  .crumb { margin-bottom: 4px; }
  h1 { font-size: clamp(2rem, 1.4vw + 1.25rem, 2.75rem); line-height: 1.02; text-wrap: balance; }
  .when { margin-top: 10px; font: 400 16px/1.4 var(--font-dos); color: var(--accent-2); overflow-wrap: anywhere; }

  .notes { padding: 14px 16px; font-size: 1rem; line-height: 1.55; color: var(--vga-0); background: var(--vga-3); box-shadow: 6px 6px 0 var(--vga-0); }
  .side h2 { margin-bottom: 14px; font: 400 16px/1 var(--font-dos); color: var(--accent); }
  .facts { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--rule); }
  .facts > div { padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .facts .wide { grid-column: 1 / -1; }
  .facts dt { font: 400 16px/1.4 var(--font-dos); color: var(--accent-2); }
  .facts dd { margin-top: 2px; font-size: 1rem; font-variant-numeric: tabular-nums; }

  /* The reading column: wide enough for his code and the toys, calm type, the outline on the right */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 980px) 240px;
    justify-content: space-between;
    gap: clamp(40px, 5vw, 88px);
    align-items: start;
    margin-top: clamp(80px, 10vw, 140px);
    padding-top: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--rule);
  }
  .read > :global(* + *) { margin-top: clamp(72px, 9vw, 120px); }
  .story h2 { font: 800 clamp(2rem, 2.4vw + 1rem, 3.25rem)/1.05 var(--font-display); font-stretch: 80%; }
  .story p { max-width: 68ch; margin-top: 18px; font-size: clamp(1.125rem, 0.3vw + 1.05rem, 1.25rem); line-height: 1.7; }
  /* Norton Commander's bottom line: the key in white on black, its job in black on cyan */
  .nc-keys { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; margin-top: clamp(80px, 10vw, 140px); padding-top: 36px; border-top: 1px solid var(--rule); }
  .nc-keys a { display: flex; min-height: 44px; min-width: 0; font: 400 16px/1 var(--font-dos); text-decoration: none; }
  .nc-keys b { display: grid; place-items: center; padding: 0 10px; font-weight: 400; color: var(--vga-15); background: var(--vga-0); }
  .nc-keys span { display: flex; align-items: center; min-width: 0; padding: 0 14px; color: var(--vga-0); background: var(--vga-3); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .nc-keys a:hover span { background: var(--vga-14); }
  .nc-keys a:focus-visible { outline: 2px solid var(--vga-14); outline-offset: 3px; }

  @media (max-width: 1199px) {
    .body { grid-template-columns: minmax(0, 1fr); }
  }
  /* Tablet and phone: name, then the running program, then the rest */
  @media (max-width: 1000px) {
    .top { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: 'ph' 'run' 'lead' 'side'; }
    .run { margin-top: 18px; }
    .lead { margin-top: 20px; max-width: 62ch; }
    .side { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px 40px; }
  }
</style>
