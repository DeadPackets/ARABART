---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Explain from '../components/explain/Explain.astro';
import { ERAS, type Era } from '../lib/eras/eras';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  hasEmulator?: boolean;
  keys?: { k: string; label: string; href?: string; act?: string }[];
  era?: Era;
  when?: [string, string];
  /** schema.org nodes for this page, added to the site's graph */
  schema?: Record<string, unknown>[];
  /** the page's place under Home, as [name, path from the site root] */
  crumbs?: [string, string][];
  pageType?: 'WebPage' | 'AboutPage' | 'ProfilePage' | 'CollectionPage';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/images/arabart-demo.png',
  hasEmulator = false,
  keys,
  era = 'dos',
  when,
  schema = [],
  crumbs,
  pageType = 'WebPage',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const imageURL = new URL(image, Astro.site);
// The 1200 x 630 share card from scripts/og/cards.py; a page without one yet shares the home card
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const cardURL = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/${existsSync(join(process.cwd(), 'public/og', `${slug}.png`)) ? slug : 'home'}.png`, Astro.site);
const home = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`, Astro.site).href;
const isHome = canonicalURL.href === home;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#site`, name: 'ARABART', url: home, inLanguage: 'en', about: { '@id': `${home}#yasser` },
      creator: { '@type': 'Person', name: 'Youssef Awad', url: 'https://github.com/DeadPackets' } },
    { '@type': 'Person', '@id': `${home}#yasser`, name: 'Yasser Awad', alternateName: 'Yasser Mohamed Ali', jobTitle: 'Software engineer', url: home,
      knowsAbout: ['Arabic computing', 'MS-DOS', 'Assembly language', 'Windows Mobile', 'Telecommunications network management'] },
    { '@type': pageType, '@id': `${canonicalURL.href}#page`, url: canonicalURL.href, name: title, description, inLanguage: 'en',
      isPartOf: { '@id': `${home}#site` }, about: { '@id': `${home}#yasser` }, primaryImageOfPage: imageURL.href,
      ...(pageType === 'ProfilePage' && { mainEntity: { '@id': `${home}#yasser` } }) },
    ...(crumbs ? [{ '@type': 'BreadcrumbList', itemListElement: [['Home', ''], ...crumbs].map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: home + path })) }] : []),
    ...schema,
  ],
};
const JSDOS = 'https://cdn.jsdelivr.net/npm/js-dos@8.5.3/dist';
---

<!DOCTYPE html>
<html lang="en" data-era={era}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content={ERAS[era].theme} />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content={isHome ? 'website' : 'article'} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={cardURL} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="ARABART" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={cardURL} />
  <meta name="twitter:image:alt" content={title} />

  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} />
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />

  {/* JS is on: toys that fill in later can reserve their space from the first paint */}
  <script is:inline>document.documentElement.classList.add('js')</script>
  <slot name="head" />

  {/* js-dos ships Tailwind preflight + daisyUI globals; a layer keeps every page rule above them. DosPlayer loads it when the program starts */}
  {hasEmulator && (
    <style is:inline set:html={`@layer reset, jsdos;`} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <meta name="jsdos-path" content={`${JSDOS}/emulators/`} />
  )}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header era={era} keys={keys} when={when} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <Explain />
</body>
</html>
