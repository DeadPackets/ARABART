<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  // Paint the glyph's runs in byte order (bottom row first, right to left), as ARABART does
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll<SVGElement>('[data-writeup="arabart"] svg[data-runs]').forEach(svg => {
      const runs = svg.querySelectorAll('.run');
      gsap.from(runs, {
        scaleX: 0, transformOrigin: '100% 50%', duration: 0.3, stagger: 0.14, ease: 'power2.out',
        scrollTrigger: { trigger: svg, start: 'top 80%', once: true },
      });
    });
  }
</script>
