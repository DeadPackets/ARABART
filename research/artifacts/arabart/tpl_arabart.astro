// ARABART flagship writeup. Every number and every pixel below comes from the unpacked ARABART 4.15 image
// (research/artifacts/programs/unpacked/ARABART_ARABART.EXE); pixel runs generated by research/artifacts/arabart/gen_web.py.
import Term from '../components/explain/Term.astro';
import Figure from '../components/explain/Figure.astro';
import Steps from '../components/explain/Steps.astro';
import ThenNow from '../components/explain/ThenNow.astro';
import Listing from '../components/explain/Listing.astro';
import Deep from '../components/explain/Deep.astro';

const DATA = __DATA__;
const tri = (a: number[]) => Array.from({ length: a.length / 3 }, (_, i) => [a[3 * i], a[3 * i + 1], a[3 * i + 2]]);
const quad = (a: number[]) => Array.from({ length: a.length / 4 }, (_, i) => [a[4 * i], a[4 * i + 1], a[4 * i + 2], a[4 * i + 3]]);
const VGA = ['#000000', '#0000AA', '#00AA00', '#00AAAA', '#AA0000', '#AA00AA', '#AA5500', '#AAAAAA',
  '#555555', '#5555FF', '#55FF55', '#55FFFF', '#FF5555', '#FF55FF', '#FFFF55', '#FFFFFF'];
const BYTES = '/ARABART/bytes/?f=ARABART_ARABART.EXE&layer=memory&at=';
const at = (cs: number) => BYTES + (cs + 0x30).toString(16).toUpperCase();

// Shaping walk: ~gtk = الفن
const WALK = [
  { key: '~', ar: 'ا', table: '30', tb: [0, 0], code: '30', sb: [0, 0], form: 'isolated', g: '0x30' },
  { key: 'g', ar: 'ل', table: 'E9', tb: [1, 1], code: 'A9', sb: [1, 0], form: 'initial', g: '0xa9' },
  { key: 't', ar: 'ف', table: 'F6', tb: [1, 1], code: 'F6', sb: [1, 1], form: 'medial', g: '0xf6' },
  { key: 'k', ar: 'ن', table: 'ED', tb: [1, 1], code: '6D', sb: [0, 1], form: 'final', g: '0x6d' },
];
const WX = [450, 330, 210, 90];
const shapedStep = [3, 4, 5, 6];
const word = (() => {
  let rx = 0; const out: number[][] = [];
  for (const w of WALK) { const g = DATA.walk[w.g]; for (const [x, y, n] of tri(g.r)) out.push([rx + x, y, n]); rx -= g.adv; }
  return { runs: out, width: -rx };
})();

// Keyboard: table at 0682h, unshifted keys (bits 7 and 6 of each code: 3 = joins both, 1 = joins right only, 0 = none)
const KB = __KB__;
const keyClass = (j: number) => (j === 3 ? 'box' : j === 1 ? 'box-ink' : 'box-dash');
const keyText = (j: number) => (j === 1 ? 't-bk' : '');
const NARROW_KB = [KB[0].slice(0, 7), KB[0].slice(7), KB[1].slice(0, 6), KB[1].slice(6), KB[2].slice(0, 5), KB[2].slice(5)];

// Glyph format example: font 1, code 37h (isolated ain)
const FMT = tri(DATA.fmt.r);
const FMT_BYTES = [
  { r: 0, b: '08 02', n: 'width 8, start 2 rows up' },
  { r: -1, b: '', n: '' },
  { r: -2, b: '01 04 EF', n: 'skip 1, paint 4, next row' },
  { r: -3, b: '00 06 EF', n: '' },
  { r: -4, b: '04 02 EF', n: '' },
  { r: -5, b: '04 02 EF', n: '' },
  { r: -6, b: '00 06 EF', n: '' },
  { r: -7, b: '00 05 EF', n: '' },
  { r: -8, b: '02 02 EF', n: '' },
  { r: -9, b: '03 01 EF', n: '' },
  { r: -10, b: '00 04 EF', n: '' },
  { r: -11, b: '00 01 FF', n: 'last run, end of glyph' },
];

const FONTS = [
  { label: 'Font 1 · 18 px · 95 glyphs · 3,442 B', ...DATA.fonts[0] },
  { label: 'Font 2 · 27 px · 103 glyphs · 5,676 B', ...DATA.fonts[1] },
  { label: 'Font 3 · 34 px · 141 glyphs · 10,838 B', ...DATA.fonts[2] },
  { label: 'Font 4 · 38 px · 87 glyphs · 6,937 B', ...DATA.fonts[3] },
  { label: 'Font 5 · 50 px · 6 glyphs · 1,039 B', ...DATA.fonts[4] },
];
let fy = 10;
const FONT_ROWS = FONTS.map(f => { const top = fy; fy += f.h * 2 + 34; return { ...f, top }; });
const FONT_H = fy;
let fny = 10;
const FONT_ROWS_N = FONTS.map(f => { const top = fny; fny += f.h * 2 + 52; return { ...f, top }; });
const FONT_HN = fny;

const FX = [
  { n: 'plain', label: 'plain' }, { n: 'bold', label: '@ bold' }, { n: 'italic', label: '! italic' },
  { n: 'underline', label: '# underline' }, { n: 'size', label: '$ size ×2' }, { n: '3d', label: 'function 8: 3-D' },
  { n: 'outline', label: 'SUN: outline' }, { n: 'shadow', label: 'SUN: shadow' },
].map(f => ({ ...f, runs: quad(DATA.fx.find((e: { n: string }) => e.n === f.n).r) }));

// Handler map (CS offsets) and the bugs found in it
const MAP = [
  { off: '003C', name: 'entry, fn 0-4', size: '197 B', w: 92 },
  { off: '0101', name: 'setup', size: '248 B', w: 100 },
  { off: '01F9', name: 'keys', size: '54 B', w: 76 },
  { off: '022F', name: 'shape', size: '142 B', w: 80 },
  { off: '02BD', name: 'draw loop', size: '672 B', w: 168 },
  { off: '055D', name: 'return', size: '135 B', w: 84 },
];
let mx = 10;
const MAPX = MAP.map(m => { const x = mx; mx += m.w + 4; return { ...m, x }; });
const BUGS = [
  { n: 1, box: 1, f: 0.54 }, { n: 2, box: 2, f: 0.48 }, { n: 3, box: 4, f: 0.38 },
  { n: 4, box: 1, f: 0.96 }, { n: 5, box: 5, f: 0.54 }, { n: 6, box: 1, f: 0.18 },
];
---

<section id="tldr">
  <ul class="tldr">
    <li>ARABART is a 30 KB program that stays in memory and adds Arabic to the PC's video service, so any program can write joined Arabic on a graphics screen with one call.</li>
    <li>Programmers typed Arabic on an English keyboard, using the keys under each Arabic letter. Two bits in every letter code then pick the right letter shape.</li>
    <li>The code is small, clever and hand-made, with no subroutines and a few real bugs. We ran his original bytes in an <Term id="emulator" /> to check how it works.</li>
  </ul>
</section>

<section id="resident">
  <h2>How does a program stay in memory after it ends?</h2>
  <p class="lead">It checks for its own name tag, takes over the screen <Term id="interrupt">interrupt</Term>, then tells DOS to keep its 30,110 bytes and end.</p>
  <Steps
    title="ARABART.EXE installs itself"
    steps={[
      'DOS loads the program: a 256-byte <code>PSP</code>, then the 30,110-byte image. The fonts are 93% of it.',
      'It asks DOS who answers <code>INT 10h</code> now, and compares 12 bytes there with its own entry: <code>EB 0A 90 "DALYASSER"</code>.',
      'No match, so it is not loaded yet. It writes the old address into its own <code>JMP FAR</code> at 004Eh, then points INT 10h at its handler, 003Ch.',
      'It clears the screen, prints its banner and waits 112 screen refreshes, about 1.6 seconds.',
      '<code>INT 27h</code> with DX = 759Eh: DOS keeps 30,110 bytes counted from the PSP and returns to the prompt.',
    ]}
  >
    <svg class="dg" viewBox="0 0 640 350" role="img" aria-labelledby="ab-res-t">
